    <string name="onboarding_slide0_title">Din morgen som team.</string>
    <string name="onboarding_slide0_body">Ingen diskussioner, intet kaos. FamWake sørger for, at alle starter dagen afslappet – helt automatisk.</string>
    <string name="onboarding_slide1_title">Aldrig mere ventetid.</string>
    <string name="onboarding_slide1_body">FamWake beregner det ideelle vækketidspunkt for hvert familiemedlem – koordineret med badeværelse, morgenmad og afgang. Ikke mere trængsel.</string>
    <string name="onboarding_slide2_title">Hver dag er anderledes.</string>
    <string name="onboarding_slide2_body">Mandag kontor, onsdag hjemmekontor? Indstil individuelle tider for hver ugedag – appen klarer resten.</string>
    <string name="onboarding_slide3_title">Forbundet på sekunder.</string>
    <string name="onboarding_slide3_body">Del en kode, og din familie er med med det samme. Nye medlemmer? Planen tilpasser sig automatisk. Og hvis noget ændrer sig, ved alle det med det samme.</string>
    <string name="onboarding_slide4_title">Lad os komme i gang!</string>
    <string name="onboarding_slide4_body">Opret din familie nu og nyd afslappede morgener – pålideligt, også offline.</string>
