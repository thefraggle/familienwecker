# Screengrab Configuration File
# Learn more at: https://docs.fastlane.tools/actions/screengrab/

app_package_name("de.familienwecker.famwake")
tests_package_name("de.familienwecker.famwake.test")

# Paths to APKs
app_apk_path("../../app/build/outputs/apk/debug/app-debug.apk")
tests_apk_path("../../app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk")

# Test settings
use_tests_in_packages(["de.familienwecker.famwake"])

# Output directory for Android screenshots
screenshots_path("screenshots")

# Clear screenshots directory before running
clear_previous_screenshots(true)

# List of locales to capture (start with DE and EN for testing)
locales(["de-DE", "en-US"])
