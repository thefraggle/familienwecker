rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hilfsfunktionen
    function signedIn() {
      return request.auth != null;
    }

    function emailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Prüft, ob der Nutzer Teil dieser Familie ist (basierend auf seinem User-Profil)
    function isFamilyMember(familyId) {
      return signedIn() && 
        ((get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId == familyId) || 
         (get(/databases/$(database)/documents/families/$(familyId)).data.createdByUserId == request.auth.uid));
    }

    // User-Profile: Nur der Eigentümer kann lesen, Schreiben nur mit verifizierter E-Mail
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId && emailVerified();
    }

    // Familien
    match /families/{familyId} {
      // Lesen erlauben, um Familienname vor dem Beitreten zu sehen oder per Code zu suchen
      allow read: if signedIn();
      
      // Jeder eingeloggte Nutzer mit verifizierter E-Mail kann eine Familie erstellen
      allow create: if signedIn() && emailVerified();
      
      // Bearbeiten/Löschen nur für Mitglieder der Familie
      allow update, delete: if isFamilyMember(familyId);

      // Mitglieder-Subcollection
      match /members/{memberId} {
        // Jeder in der Familie kann die Mitglieder sehen; Erstellen/Bearbeiten nur mit verifizierter E-Mail
        allow read: if isFamilyMember(familyId);
        allow create, update: if isFamilyMember(familyId) && emailVerified();
        
        // Spezifische Lösch-Logik:
        // Ein Mitglied darf NUR gelöscht werden, wenn:
        // 1. Es nicht geclaimt ist (claimedByUserId == null)
        // ODERE
        // 2. Es der eigene Claim des Nutzers ist (claimedByUserId == uid)
        allow delete: if isFamilyMember(familyId) && 
          (resource.data.claimedByUserId == null || 
           resource.data.claimedByUserId == request.auth.uid);
      }
    }
  }
}
