rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hilfsfunktionen
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/_admins/$(request.auth.uid));
    }

    // Prüft, ob der Nutzer Teil dieser Familie ist.
    // Optimiert: familyPath nur einmal als Variable, get() nur einmal aufgerufen
    // um das Firestore-Rules-Limit von 10 Reads/Request nicht zu gefährden.
    function isFamilyMember(familyId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let familyPath = /databases/$(database)/documents/families/$(familyId);
      let familyData = exists(familyPath) ? get(familyPath).data : null;
      return isAdmin() || (signedIn() &&
        (
          // Option A: familyId ist im User-Dokument hinterlegt
          (exists(userPath) && get(userPath).data.familyId == familyId) ||
          // Option B + C: Familie-Dokument einmal lesen, Creator- und userIds-Check kombiniert
          (familyData != null && (
            familyData.createdByUserId == request.auth.uid ||
            (familyData.keys().hasAll(['userIds']) && request.auth.uid in familyData.userIds)
          ))
        ));
    }

    // User-Profile: Nur der Eigentümer kann lesen.
    // Schreibzugriffe erfolgen ausschließlich über Cloud Functions (Security Fix).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Familien-Dokumente
    match /families/{familyId} {
      // isFamilyMember prüft userIds intern bereits (Option C) – kein zweiter Check nötig.
      allow read: if isFamilyMember(familyId);

      // Kein direkter Client-Zugriff für Create (nur Cloud Functions)
      allow create: if false;

      // Update nur für Mitglieder; createdByUserId und joinCode dürfen vom Client nie geändert werden.
      // Hinweis: Cloud Functions nutzen das Admin SDK und umgehen diese Rules vollständig –
      // createFamily, joinFamilyByCode, leaveFamily etc. funktionieren weiterhin uneingeschränkt.
      allow update: if isFamilyMember(familyId) && 
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdByUserId', 'joinCode']));
      
      // Löschen erlaubt wenn der Nutzer der Ersteller ist ODER Admin
      allow delete: if isAdmin() || (signedIn() && resource.data.createdByUserId == request.auth.uid);

      // Mitglieder-Subcollection
      match /members/{memberId} {
        // WICHTIG: Erlaubt Queries auf Mitglieder, wenn man Teil der Familie ist
        allow read: if isFamilyMember(familyId);
        
        // Erstellen erlaubt für alle Familienmitglieder (z.B. neues Profil anlegen)
        allow create: if isFamilyMember(familyId);

        // Update: Familienmitglieder dürfen isAwakeToday und isPaused für ALLE setzen
        // (bewusste Design-Entscheidung: Familie koordiniert Wecker gemeinsam).
        // Schutz: 'name' und 'claimedByUserId' dürfen nur vom Owner oder Admin geändert werden.
        allow update: if isFamilyMember(familyId) &&
          (
            // Alle dürfen diese koordinativen Felder schreiben
            !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['name', 'claimedByUserId', 'soundUri', 'wakeWindowMinutes', 'bathroomMinutes'])
            ||
            // Oder: Admin darf alles
            isAdmin()
          );

        // Löschen erlaubt für alle Familienmitglieder.
        // isAdmin() ist in isFamilyMember() bereits enthalten – kein redundanter Check.
        allow delete: if isFamilyMember(familyId);
      }
    }

    // Rate-Limit-Tracking & Admin-Liste – nur von Cloud Functions (Admin SDK) beschreibbar
    match /_rate_limits/{doc} {
      allow read, write: if false;
    }
    match /_admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Feedback: Nur Admins dürfen lesen, bearbeiten und löschen.
    // Erstellen darf jeder eingeloggte Nutzer (write würde auch update/delete erlauben).
    match /feedback/{doc} {
      allow read, update, delete: if isAdmin();
      allow create: if signedIn();
    }
  }
}
