rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Hilfsfunktionen
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/_admins/$(request.auth.uid));
    }

    // Prüft, ob der Nutzer Teil dieser Familie ist
    function isFamilyMember(familyId) {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let familyPath = /databases/$(database)/documents/families/$(familyId);
      return isAdmin() || (signedIn() && 
        (
          // Option A: familyId ist im User-Dokument hinterlegt (Check ob Doc existiert)
          (exists(userPath) && get(userPath).data.familyId == familyId) || 
          // Option B: Der Nutzer ist der Ersteller (Fallback für Onboarding)
          (exists(familyPath) && get(familyPath).data.createdByUserId == request.auth.uid)
        ));
    }

    // User-Profile: Nur der Eigentümer kann lesen.
    // Schreibzugriffe erfolgen ausschließlich über Cloud Functions (Security Fix).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Familien-Dokumente
    match /families/{familyId} {
      // Mitglieder dürfen lesen (isFamilyMember deckt auch Creator ab)
      allow read: if isFamilyMember(familyId);

      // Kein direkter Client-Zugriff für Create (nur Cloud Functions)
      allow create: if false;

      // Update nur für Mitglieder; createdByUserId darf niemals geändert werden
      allow update: if isFamilyMember(familyId) && 
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdByUserId']));
      
      // Löschen erlaubt wenn der Nutzer der Ersteller ist ODER Admin
      allow delete: if isAdmin() || (signedIn() && resource.data.createdByUserId == request.auth.uid);

      // Mitglieder-Subcollection
      match /members/{memberId} {
        allow read: if isFamilyMember(familyId);
        
        // Erstellen/Ändern erlaubt für alle Familienmitglieder (ohne E-Mail-Lock)
        allow create, update: if isFamilyMember(familyId);

        // Löschen erlaubt wenn Mitglied der Familie UND (Admin ODER ungeclaimt ODER eigener Claim ODER Creator der Familie)
        allow delete: if isFamilyMember(familyId) &&
          (isAdmin() ||
           resource.data.claimedByUserId == null ||
           resource.data.claimedByUserId == request.auth.uid ||
           get(/databases/$(database)/documents/families/$(familyId)).data.createdByUserId == request.auth.uid);
      }
    }

    // Rate-Limit-Tracking & Admin-Liste – nur von Cloud Functions (Admin SDK) beschreibbar
    match /_rate_limits/{doc} {
      allow read, write: if false;
    }
    match /_admins/{doc} {
      allow read, write: if false;
    }

    // Feedback: Nur Admins dürfen lesen; jeder Eingeloggte darf schreiben
    match /feedback/{doc} {
      allow read: if isAdmin();
      allow write: if signedIn();
    }
  }
}
