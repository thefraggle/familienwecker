# Copy this file to local.properties and fill in your local values.
# Never commit local.properties to version control.

# Path to your Android SDK (auto-generated by Android Studio)
# sdk.dir=/path/to/Android/sdk

# Optional: Firebase / Google Sign-In Web Client ID
# DEFAULT_WEB_CLIENT_ID=

# Optional: RevenueCat Public SDK Key (leave empty to disable in-app purchases in local builds)
# REVENUECAT_PUBLIC_API_KEY=

# Optional: Aptabase Analytics (leave empty to disable telemetry in local builds)
# APTABASE_APP_KEY=
# APTABASE_HOST=
