    "unsaved_changes_message": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিবর্তনগুলো বাতিল করবেন?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du kassere dine ændringer?"
          }
        },
        "de": {
