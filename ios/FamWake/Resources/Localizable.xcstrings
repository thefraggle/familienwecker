    "unsaved_changes_message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du deine Änderungen wirklich verwerfen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を保存せずに閉じますか？"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला तुमचे बदल रद्द करायचे आहेत का?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want to drop your changes?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бажаєте скасувати ваші зміни?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres descartar tus cambios?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du kassere dine ændringer?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi scartare le modifiche?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vill du förkasta dina ändringar?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경사항을 취소하시겠습니까?"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wottsch diini Änderige würkli verwerfe?"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vil du forkaste endringene dine?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişikliklerden vazgeçmek istiyor musunuz?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz odrzucić zmiany?"
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Willze den ganzen Kram echt inne Tonne kloppen?"
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Woisch dei Sächle wirklich verwerfa?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có muốn hủy các thay đổi của mình không?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите отменить ваши изменения?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veux-tu annuler tes modifications ?"
          }
        },
        "id": {
          "stringUnit": {
