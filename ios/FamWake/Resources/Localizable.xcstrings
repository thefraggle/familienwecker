    "main_fallback_alarm_active": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Achtung: Der Plan passt gerade nicht (%@). Bitte passe deine Zeiten an!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 注意：現在スケジュールがうまく合っていません（%@）。時間を調整してください！"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ चेतावणी: वेळापत्रक सध्या जुळत नाही (%@). कृपया तुमच्या वेळा व्यवस्थित करा!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Warning: The schedule doesn't fit right now (%@). Please adjust your times!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Увага: Розклад зараз не збігається (%@). Будь ласка, скоригуйте час!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Aviso: El horario no encaja ahora mismo (%@). ¡Por favor, ajusta tus horas!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Advarsel: Tidsplanen passer ikke lige nu (%@). Juster venligst jeres tider!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Attenzione: Il programma non quadra in questo momento (%@). Per favore, aggiusta i tuoi orari!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Varning: Schemat passar inte just nu (%@). Justera dina tider!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 주의: 현재 일정이 맞지 않습니다(%@). 시간을 조정해 주세요!"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Achtung: De Plan passt grad nöd (%@). Bitte pass diini Ziite aa!"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Advarsel: Tidsplanen passer ikke akkurat nå (%@). Vennligst juster tidene dine!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Uyarı: Plan şu anda uyuşmuyor (%@). Lütfen saatlerinizi ayarlayın!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Uwaga: Obecny harmonogram nie pasuje (%@). Dostosuj swoje czasy!"
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Wat passt hier nich (%@). Kümmer dich ma um de Zeiten!"
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Achtong: Dr Plan basst grad net (%@). Bitte richte dei Zeita!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Cảnh báo: Lịch trình hiện tại không khớp (%@). Vui lòng điều chỉnh thời gian của bạn!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Внимание: Расписание сейчас не сходится (%@). Пожалуйста, скорректируйте время!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Attention : Le planning ne correspond pas pour l'instant (%@). Merci d'ajuster vos horaires !"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Peringatan: Jadwal tidak pas saat ini (%@). Tolong sesuaikan waktu Anda!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Let op: Het schema past momenteel niet (%@). Pas a.u.b. je tijden aan!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Aviso: O cronograma não se encaixa agora (%@). Por favor, ajuste seus horários!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ সতর্কবার্তা: এখনকার রুটিনটি ঠিক মিলছে না (%@)। সময়গুলো একটু ঠিক করুন!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ चेतावनी: अभी के हिसाब से रूटीन फ़िट नहीं हो रहा है (%@)। कृपया अपना समय थोड़ा एडजस्ट करें!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 警告：当前日程存在冲突 (%@)。请调整您的时间！"
          }
        }
      }
    },
