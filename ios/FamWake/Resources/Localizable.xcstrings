          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсив означає, що сімейний буфер активний. Змініть його, щоб встановити особистий буфер на сьогодні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chữ in nghiêng có nghĩa là thời gian dự phòng gia đình đang hoạt động. Hãy thay đổi nó để đặt thời gian dự phòng cá nhân cho hôm nay."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
