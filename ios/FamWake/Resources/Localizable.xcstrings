    "simple_mode_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Weckzeit ohne Puffer oder Berechnung der Badezimmerzeiten."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆとり時間やバスルームの順番計算を含まない、固定の起床時間です。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अतिरिक्त वेळ किंवा बाथरूमच्या वेळेची गणना न करता उठण्याची निश्चित वेळ।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed wake-up time without buffer or bathroom slot calculation."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фіксований час пробудження без запасу часу або розрахунку часу на ванну."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de despertar fija sin margen ni cálculo de turnos para el baño."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast vækketid uden margin eller beregning af badeværelsestid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Orario di sveglia fisso senza margine o calcolo dei turni in bagno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast väckningstid utan marginal eller beräkning av badrumstid."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 시간이나 욕실 사용 시간 계산 없는 고정된 기상 시간입니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Feschti Weckziit ohni Puffer oder d'Berächnig vo de Badzimmerziite."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast vekketid uten margin eller beregning av baderomstid."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampon süre veya banyo sırası hesaplaması olmadan sabit uyanma saati."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stała godzina pobudki bez marginesu czasowego i obliczania czasu w łazience."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Feste Weckzeit ohne Puffer oder Rechnerei fürs Bad."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Feschde Weckzeit ohne Puffer oder s'Ausrechna vo de Badzeita."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ thức dậy cố định, không tính thời gian đệm hoặc thời gian dùng phòng tắm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фиксированное время пробуждения без запаса времени или расчета времени на ванную."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heure de réveil fixe sans marge ni calcul du temps de passage à la salle de bain."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu bangun tetap tanpa jeda atau perhitungan waktu kamar mandi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaste wektijd zonder marge of berekening van badkamertijd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora de acordar fixa sem margem ou cálculo de turnos no banheiro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অতিরিক্ত সময় বা বাথরুম ব্যবহারের সময় গণনা ছাড়াই নির্দিষ্ট ঘুম থেকে ওঠার সময়।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अतिरिक्त समय या बाथरूम के समय की गणना के बिना उठने का निश्चित समय।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "固定叫醒时间，不计算缓冲时间或洗手间时间。"
          }
        }
      }
    },
    "tooltip_buffer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursiv bedeutet: Der Familien-Puffer ist aktiv. Ändere ihn, um einen persönlichen Puffer für heute zu setzen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "斜体は家族のバッファが有効であることを意味します。変更して、今日の個人的なバッファを設定してください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इटॅलिक म्हणजे फॅमिली बफर सक्रिय आहे. आजसाठी तुमचा स्वतःचा बifer सेट करण्यासाठी ते बदला."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Italics mean the family buffer is active. Change it to set a personal buffer for today."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсив означає, що сімейний буфер активний. Змініть його, щоб встановити особистий буфер на сьогодні."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cursiva significa que el margen familiar está activo. Cámbialo para establecer un margen personal para hoy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursiv betyder, at familie-bufferen er aktiv. Ændr den for at indstille en personlig buffer for i dag."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il corsivo indica che il buffer familiare è attivo. Modificalo per impostare un buffer personale per oggi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursiv stil betyder att familjebufferten är aktiv. Ändra den för att ställa in en personlig buffert för idag."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기울임꼴은 가족 여유 시간이 활성화되어 있음을 의미합니다. 오늘 나만의 여유 시간을 설정하려면 변경하세요."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursiv bedütet: De Familie-Puffer isch aktiv. Änder en, um en persönliche Puffer für hüt z setze."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursiv betyr at familie-bufferen er aktiv. Endre den for å angi en personlig buffer for i dag."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İtalik yazı, aile ek süresinin aktif olduğunu gösterir. Bugün için kişisel bir ek süre ayarlamak üzere bunu değiştirin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursywa oznacza, że bufor rodzinny jest aktywny. Zmień go, aby ustawić osobisty bufor na dzisiaj."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursiv heißt: Der Familien-Puffer is an. Änder den einfach, um dir für heute nen eigenen Puffer zu setzen."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Kursiv hoißt: Dr Familien-Puffer isch aktiv. Ändr des, um an oigenen Puffer fir heit zom setza."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chữ in nghiêng có nghĩa là thời gian dự phòng gia đình đang hoạt động. Hãy thay đổi nó để đặt thời gian dự phòng cá nhân cho hôm nay."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Курсив означает, что включен семейный буфер. Измените его, чтобы установить личный буфер на сегодня."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'italique signifie que la marge familiale est active. Modifiez-la pour définir une marge personnelle pour aujourd'hui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Huruf miring berarti buffer keluarga aktif. Ubah untuk mengatur buffer pribadi untuk hari ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cursief betekent dat de familie-buffer actief is. Pas dit aan om een persoonlijke buffer voor vandaag in te stellen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O itálico significa que o buffer familiar está ativo. Altere-o para definir um buffer pessoal para hoje."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইটালিক মানে ফ্যামিলি বাফার চালু আছে। আজকের জন্য নিজের বাফার সেট করতে এটি পরিবর্তন করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इटैलिक का मतलब है कि फैमिली बफर एक्टिव है। आज के लिए अपना बफर सेट करने के लिए इसे बदलें।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "斜体表示家庭缓冲时间处于开启状态。更改它即可为今天设置个人缓冲时间。"
          }
        }
      }
    },
