    "settings_support_desc": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটি ভালো লেগেছে? আমরা আপনার সাপোর্ট খুব পছন্দ করব!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan du lide appen? Vi vil elske din støtte!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gefällt dir die App? Wir freuen uns riesig über deine Unterstützung!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you like the app? We would love your support!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te gusta la app? ¡Agradeceríamos mucho tu apoyo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu aimes l'appli ? Ton soutien nous ferait très plaisir !"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gfallt dir d'App? Mir freued ois riesig über diini Unterstützig!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आपको ऐप पसंद आया? हमें आपके सपोर्ट से बहुत ख़ुशी होगी!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda menyukai aplikasi ini? Kami sangat menghargai dukungan Anda!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti piace l'app? Apprezzeremmo molto il tuo supporto!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを気に入っていただけましたか？ご支援いただけると大変嬉しいです！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 마음에 드시나요? 여러분의 응원이 큰 힘이 됩니다!"
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Bock auf die App? Wir freuen uns über jeden Groschen!"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला ॲप आवडते का? तुमच्या सपोर्टची आम्हाला खूप मदत होईल!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Liker du appen? Vi setter stor pris på din støtte!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind je de app leuk? We zouden je steun erg waarderen!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podoba Ci się aplikacja? Będziemy wdzięczni za Twoje wsparcie!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Gosta do app? Ficaríamos felizes com o seu apoio!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам нравится приложение? Мы будем очень рады вашей поддержке!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gillar du appen? Vi skulle uppskatta ditt stöd!"
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Gfallt dr d'App? Mir freuet ons sackrisch iber a bissle Onterstützong!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı beğendiniz mi? Desteğiniz bizi çok mutlu eder!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам подобається додаток? Ми будемо дуже раді вашій підтримці!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thích ứng dụng này không? Chúng tôi rất trân trọng sự hỗ trợ của bạn!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "您喜欢这个应用吗？非常感谢您的支持！"
          }
        }
      }
    },
