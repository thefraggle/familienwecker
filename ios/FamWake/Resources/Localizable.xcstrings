    "schedule_message_no_valid": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeiten überschneiden sich zu stark für einen guten Plan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間が重なりすぎていて、良いスケジュールが作れません。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "चांगले वेळापत्रक तयार करण्यासाठी वेळा खूप जास्त ओव्हरलॅप होत आहेत."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The times overlap too much to create a good schedule."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час занадто сильно перетинається, щоб скласти хороший розклад."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas se cruzan demasiado para crear un buen horario."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiderne overlapper for meget til at lave en god tidsplan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli orari si sovrappongono troppo per creare un buon programma."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiderna överlappar för mycket för att skapa ett bra schema."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 너무 많이 겹쳐서 좋은 일정을 만들 수 없습니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "D'Ziite überschniided sich z'starch für en guete Plan."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidene overlapper for mye til å lage en god tidsplan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saatler, iyi bir plan oluşturmak için çok fazla çakışıyor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czasy nakładają się zbyt mocno, by stworzyć dobry plan."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Das passt vorne und hinten nicht. Zu viel überschnitten."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "So wird des nix, d'Zeita überschneidet sich z'arg."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian trùng lặp quá nhiều để tạo ra một lịch trình tốt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время слишком сильно пересекается, чтобы составить хорошее расписание."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horaires se chevauchent trop pour créer un bon planning."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktunya terlalu tumpang tindih untuk membuat jadwal yang pas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tijden overlappen te veel om een goed schema te maken."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os horários se sobrepõem demais para criar um bom cronograma."
          }
