    "schedule_message_no_valid_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Vergrößere dein Weck-Fenster, verkürze die Bad-Zeit oder pausiere den Wecker von jemandem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヒント：起きる時間の枠を広げるか、バスルームの時間を短くするか、誰かのアラームを一時停止してみてください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "टीप: तुमची उठण्याची वेळ वाढवा, बाथरूमचा वेळ कमी करा किंवा एखाद्याचा अलार्म थांबवा."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Try a wider wake-up window, shorter bathroom time, or pause someone's alarm."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порада: Спробуйте розширити вікно пробудження, скоротити час у ванній або поставити чийсь будильник на паузу."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consejo: prueba con un margen de despertar más amplio, menos tiempo de baño, o pausa la alarma de alguien."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Prøv et bredere opvågningsvindue, kortere badeværelsestid, eller sæt nogens alarm på pause."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerimento: prova una finestra di risveglio più ampia, un tempo in bagno più breve, o metti in pausa la sveglia di qualcuno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: Prova ett bredare väckningsfönster, kortare tid i badrummet, eller pausa någons larm."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팁: 일어나는 시간 범위를 넓히거나, 화장실 시간을 줄이거나, 다른 사람의 알람을 일시 정지해 보세요."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Vergrösser diis Weck-Fänster, verchürz d'Bad-Ziit oder pausier de Wecker vo öpperem."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: Prøv et bredere oppvåkningsvindu, kortere tid på badet, eller sett noens alarm på pause."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İpucu: Uyanma aralığınızı genişletmeyi, banyo sürenizi kısaltmayı veya birinin alarmını duraklatmayı deneyin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówka: Zwiększ przedział pobudki, skróć czas w łazience lub wstrzymaj czyjś alarm."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Mach ma Weckfenster größer, geh nich so lang ins Bad oder drück bei wem auf Pause."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp: Mach dei Wegg-Fenschderle greßer, d'Bad-Zeit kürzer oder pausier amol oin Wegger."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mẹo: Thử mở rộng khoảng thời gian thức dậy, rút ngắn thời gian dùng phòng tắm hoặc tạm dừng báo thức của ai đó."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совет: Попробуйте расширить окно пробуждения, сократить время в ванной или поставить чей-то будильник на паузу."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Astuce : Essaie d'élargir l'heure de réveil, de raccourcir le temps de salle de bain ou de mettre le réveil de quelqu'un en pause."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tips: Coba perpanjang waktu bangun, perpendek waktu mandi, atau jeda alarm seseorang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tip: Probeer de wektijd te verruimen, de badkamertijd in te korten of zet iemands wekker op pauze."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dica: Tente aumentar a janela para acordar, reduzir o tempo no banheiro ou pausar o alarme de alguém."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরামর্শ: ওঠার সময়টা একটু বাড়িয়ে দিন, বাথরুমের সময় কমান, অথবা কারো অ্যালার্ম পজ করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव: उठने का समय थोड़ा बढ़ाएँ, बाथरूम का समय कम करें, या किसी का अलार्म कुछ समय के लिए रोक दें।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "提示：尝试扩大起床时间范围、缩短洗漱时间或暂停某人的闹钟。"
          }
        }
      }
    },
