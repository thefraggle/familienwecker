    "notif_channel_schedule_change_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt dir Bescheid, wenn sich Weckzeiten oder die Bad-Reihenfolge ändern"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる時間やバスルームの順番が変わった時にお知らせします"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उठण्याची वेळ किंवा बाथरूमचा क्रम बदलल्यास तुम्हाला माहिती देते"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you if wake-up times or bathroom order change"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомляє вам, якщо час пробудження або черга у ванну змінюються"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisa si las horas de despertar o el orden en el baño cambian"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæller dig, hvis opvågningstider eller rækkefølge på badeværelset ændres"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisa se cambiano gli orari di sveglia o l'ordine in bagno"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelar dig om väckningstider eller ordningen i badrummet ändras"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기상 시간이나 화장실 순서가 바뀌면 알려줍니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Säit dir Bscheid, wänn sich Weckziite oder d'Bad-Reihefolg ändered"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Gir deg beskjed hvis oppvåkningstider eller rekkefølgen på badet endres"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanma saatleri veya banyo sırası değiştiğinde sana haber verir"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informuje Cię, czy zmieniły się czasy pobudki lub kolejność w łazience"
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Sacht Bescheid, wenn sich beim Wecken oder inne Reihenfolge wat ändert."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt dr Bscheid, wenn sich bei de Weggzeita oder dr Bad-Reihafolg was ändert"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho bạn biết nếu thời gian thức dậy hoặc thứ tự vào phòng tắm thay đổi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает вам, если время пробуждения или порядок очереди в ванную меняются"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te prévient si les heures de réveil ou l'ordre de passage changent"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi tahu jika waktu bangun atau urutan kamar mandi berubah"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat het je weten als de wektijden of badkamervolgorde veranderen"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa se o horário de acordar ou a ordem do banheiro mudarem"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওঠার সময় বা বাথরুমের সিরিয়াল বদলালে আপনাকে জানায়"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उठने का समय या बाथरूम जाने का क्रम बदलने पर आपको बताता है"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "如果起床时间或洗漱顺序发生变化，将通知您"
          }
        }
      }
    },
