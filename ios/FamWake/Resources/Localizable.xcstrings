        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna cuenta de Google. Por favor, inicia sesión en Google en los ajustes de tu teléfono o usa correo y contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
