    "notif_channel_family_events_desc": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরিবারে কেউ যুক্ত হলে বা ছাড়লে আপনাকে জানায়"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortæller dig, når folk slutter sig til eller forlader din familie"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt dir Bescheid, wenn jemand deiner Familie beitritt oder sie verlässt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tells you when people join or leave your family group"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisa cuando alguien entra o sale de tu familia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te prévient quand quelqu'un rejoint ou quitte la famille"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Säit dir Bscheid, wänn öpper diinere Familie biitritt oder si verlaht"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब कोई आपके परिवार के ग्रुप में जुड़ता है या उसे छोड़ता है, तो आपको बताता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memberi tahu saat seseorang bergabung atau meninggalkan grup keluarga Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisa quando qualcuno entra o esce dalla tua famiglia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かが家族に参加したり抜けたりした時にお知らせします"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 가족 그룹에 들어오거나 나갈 때 알려줍니다."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Sacht Bescheid, wenn einer dazukommt oder abhaut."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "जेव्हा कोणी तुमच्या कुटुंबात सामील होते किंवा कुटुंब सोडते तेव्हा तुम्हाला माहिती देते"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gir deg beskjed når folk blir med i eller forlater familiegruppen din"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertelt je wanneer mensen zich aansluiten bij of vertrekken uit je familiegroep"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Informuje Cię, gdy ktoś dołączy do Twojej grupy rodzinnej lub ją opuści"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa quando alguém entra ou sai da sua família"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщает вам, когда люди присоединяются или покидают вашу семейную группу"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Meddelar dig när personer går med i eller lämnar din familjegrupp"
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagt dr Bscheid, wenn ebber in d'Familie neikommt oder nausgoht"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanlar aile grubuna katıldığında veya ayrıldığında sana haber verir"
