    "main_unclaimed_first_desc": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ সবার আগে উঠবে, কিন্তু ফোনে প্রোফাইল বেছে নেয়নি – ঘুম থেকে উঠতে দেরি হতে পারে!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er først i rækken, men har ikke valgt sin profil på en telefon endnu – og sover måske over sig!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist als Erstes dran, hat aber noch kein Profil auf dem Handy ausgewählt – und verschläft vielleicht!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is first in line but hasn't selected their profile on a phone yet – they might oversleep!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ es el primero, pero no ha seleccionado su perfil en ningún teléfono – ¡podría quedarse dormido!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en première position, mais n'a pas encore sélectionné son profil sur un téléphone – et risque de trop dormir !"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isch a erster Stell, hät aber na käs Profil ufem Handy uusgwählt – und verschlaaft villicht!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सबसे पहले उठने वाले हैं, लेकिन अभी तक फ़ोन पर अपनी प्रोफ़ाइल नहीं चुनी है – वे शायद देर तक सोते रह जाएँ!"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ berada di urutan pertama tetapi belum memilih profilnya di ponsel – dia bisa bangun kesiangan!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è al primo posto, ma non ha ancora selezionato il suo profilo sul telefono – potrebbe non svegliarsi in tempo!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は1番目ですが、まだ自分のプロフィールを選択していません – 寝坊してしまうかもしれません！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 첫 번째 순서지만 아직 휴대폰에서 프로필을 선택하지 않았습니다. 늦잠을 잘 수도 있어요!"
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is als erstes dran, hat abba noch kein Profil auffem Handy ausgewählt – pennt dann einfach durch, wa."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ रांगेत पहिले आहेत परंतु त्यांनी अजून फोनवर त्यांचे प्रोफाइल निवडले नाही – त्यामुळे ते कदाचित उशिरा उठतील!"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er først i rekken, men har ikke valgt profilen sin på en telefon ennå – og forsover seg kanskje!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ staat op de eerste plaats, maar heeft nog geen eigen profiel gekozen – en verslaapt zich misschien!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest na pierwszym miejscu, ale nie ma jeszcze wybranego profilu na telefonie – więc może zaspać!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ é o primeiro da fila, mas ainda não escolheu seu perfil no celular – e pode acabar dormindo demais!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ стоит на первом месте, но не выбрал свой профиль на телефоне – и может проспать!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är först i kön, men har inte valt sin profil på en telefon ännu – och försover sig kanske!"
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ischt an erster Stell, hat aber koi eigets Profil uffm Handy – ond verschläft noher no!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ilk sırada ama henüz telefonunda profilini seçmedi – uyanamayabilir!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ стоїть на першому місці, але ще не вибрав свій профіль на телефоні – і може проспати!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ xếp hàng đầu tiên nhưng chưa chọn hồ sơ trên điện thoại – và có thể sẽ ngủ quên!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 排在第一位，但还没有在手机上选择个人资料——可能会睡过头！"
          }
        }
      }
    },
