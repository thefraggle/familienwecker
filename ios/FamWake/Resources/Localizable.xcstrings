    "login_verify_email_text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben eine kurze E-Mail geschickt an\n%@\nBitte klicke auf den Link darin, um dein Konto zu aktivieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認メールを送信しました：\n%@\nメール内のリンクをタップしてアカウントを有効にしてください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आम्ही \n%@\n वर एक छोटा ईमेल पाठवला आहे. तुमचे खाते सक्रिय करण्यासाठी कृपया त्यातील लिंकवर क्लिक करा."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We sent a quick email to\n%@\nPlease click the link in it to activate your account."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми відправили короткий лист на\n%@\nБудь ласка, натисніть на посилання в ньому, щоб активувати акаунт."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos enviado un correo rápido a\n%@\nHaz clic en el enlace del correo para activar tu cuenta."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har sendt en kort e-mail til\n%@\nKlik på linket i den for at aktivere din konto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo inviato una breve email a\n%@\nClicca sul link al suo interno per attivare il tuo account."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi skickade just ett mejl till\n%@\nKlicka på länken i det för att aktivera ditt konto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 주소로 확인 메일을 보냈습니다:\n%@\n메일 안의 링크를 클릭하여 계정을 활성화해 주세요."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir händ e churzi E-Mail gschickt a\n%@\nBitte klick uf de Link det dinne, zum diis Konto z'aktiviere."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi har sendt en rask e-post til\n%@\nKlikk på lenken i den for å aktivere kontoen din."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\nadresine kısa bir e-posta gönderdik. Hesabınızı aktifleştirmek için lütfen içindeki bağlantıya tıklayın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłaliśmy krótką wiadomość na adres\n%@\nKliknij link w środku, aby aktywować swoje konto."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Haben wat zum Bestätigen geschickt an\n%@\nBitte auf den Link in der Mail hämmern."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir hänn dr was kurzes gschiggt an\n%@\nBitte druffklicka uff den Link zom Aktiviera."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi đã gửi một email nhanh đến\n%@\nVui lòng nhấp vào liên kết trong email để kích hoạt tài khoản của bạn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы отправили короткое письмо на\n%@\nПожалуйста, нажмите на ссылку в нем, чтобы активировать аккаунт."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons envoyé un petit e-mail à\n%@\nClique sur le lien à l'intérieur pour activer ton compte."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami mengirimkan email singkat ke\n%@\nSilakan klik tautan di dalamnya untuk mengaktifkan akun Anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We hebben zojuist een e-mail gestuurd naar\n%@\nKlik op de link in het bericht om je account te activeren."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos um email rápido para\n%@\nPor favor, clique no link dentro dele para ativar sua conta."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা \n%@\n-এ একটি ইমেইল পাঠিয়েছি। অ্যাকাউন্ট চালু করতে ইমেইলের লিঙ্কটিতে ক্লিক করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमने \n%@\n पर एक छोटा सा ईमेल भेजा है। अपना अकाउंट चालू करने के लिए उसमें दिए गए लिंक पर क्लिक करें।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "我们向\n%@ 发送了一封验证邮件\n请点击邮件中的链接以激活您的帐号。"
          }
        }
      }
    },
