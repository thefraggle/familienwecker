    "error_join_family_rate_limit": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেক বেশি চেষ্টা করা হয়েছে। একটু অপেক্ষা করে আবার চেষ্টা করুন।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange forsøg. Vent et øjeblik og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Bitte warte einen Moment und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Please wait a moment and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Espera un momento y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives. Attends un instant et réessaie."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Z'vill Versüech. Bitte wart churz und probiers namal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत ज़्यादा कोशिशें हो गईं। कृपया थोड़ी देर रुकें और फिर कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlalu banyak percobaan. Tunggu sebentar dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi. Aspetta un attimo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスが多すぎます。少し待ってからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시도가 너무 많습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisse am spamen? Wart ma ganz kurz."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "खूप वेळा प्रयत्न केले. कृपया थोडा वेळ थांबा आणि पुन्हा प्रयत्न करा."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange forsøk. Vent et øyeblikk og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te veel pogingen. Wacht even en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbyt wiele prób. Poczekaj chwilę i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Muitas tentativas. Espere um momento e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток. Подождите немного и попробуйте снова."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För många försök. Vänta ett ögonblick och försök igen."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Z'oft probiert. Bitte kurz warta ond nomal guga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çok fazla deneme yapıldı. Lütfen biraz bekleyip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Занадто багато спроб. Зачекайте трохи і спробуйте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử quá nhiều lần. Vui lòng đợi một chút và thử lại."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试次数过多。请稍等片刻再试。"
          }
        }
      }
    },
