    "onboarding_slide5_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die App direkt ohne Konto ausprobieren. Du brauchst erst eins, wenn du deine Familie einladen möchtest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントがなくてもすぐにアプリを試せます。アカウントが必要になるのは、家族を招待する時だけです。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही खाते न बनवताही ॲप लगेच वापरून पाहू शकता. जेव्हा तुम्हाला तुमच्या कुटुंबाला आमंत्रित करायचे असेल तेव्हाच तुम्हाला खात्याची आवश्यकता असेल."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can try the app right away without an account. You only need one when you want to invite your family."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете спробувати додаток відразу без облікового запису. Він знадобиться лише тоді, коли ви захочете запросити свою сім'ю."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes probar la app ahora mismo sin tener cuenta. Solo necesitarás una cuando quieras invitar a tu familia."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan prøve appen med det samme uden en konto. Du behøver kun en, når du vil invitere din familie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi provare l'app fin da subito senza un account. Ne avrai bisogno solo quando vorrai invitare la tua famiglia."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan prova appen direkt utan ett konto. Du behöver bara ett när du vill bjuda in din familj."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 없어도 바로 앱을 사용해 볼 수 있습니다. 가족을 초대하고 싶을 때만 계정을 만드시면 됩니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Du chasch d'App diräkt ohni Konto uusprobiere. Eises bruuchsch erst, wänn du diini Familie iilade wottsch."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan prøve appen med en gang uten konto. Du trenger bare en når du vil invitere familien din."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap oluşturmadan uygulamayı hemen deneyebilirsin. Sadece ailenizi davet etmek istediğinizde bir hesaba ihtiyacınız olacak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wypróbować aplikację od razu, bez posiadania konta. Będziesz go potrzebować dopiero wtedy, gdy będziesz chciał zaprosić swoją rodzinę."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör ma, du kanns die App direkt ohne Anmeldung ausprobieren. Ein Konto brauchsse erst, wenn de deine Familie einläds."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannsch d'App direkt ohne Aameldung ausprobiera. A Konto brauchsch erscht, wenn de dei Familie eiladsch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể dùng thử ứng dụng ngay mà không cần tài khoản. Bạn chỉ cần tài khoản khi muốn mời gia đình của mình tham gia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете попробовать приложение прямо сейчас без аккаунта. Он понадобится вам только тогда, когда вы захотите пригласить свою семью."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux essayer l'appli tout de suite sans avoir de compte. Tu n'en auras besoin que lorsque tu voudras inviter ta famille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat langsung mencoba aplikasinya tanpa akun. Anda hanya memerlukan akun saat ingin mengundang keluarga Anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de app meteen uitproberen zonder account. Je hebt er pas een nodig als je je familie wilt uitnodigen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode testar o app na hora sem uma conta. Você só vai precisar de uma quando quiser convidar sua família."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অ্যাকাউন্ট ছাড়াই অ্যাপটি ব্যবহার করে দেখতে পারেন। আপনি যখন পরিবারকে আমন্ত্রণ জানাতে চাইবেন, তখনই অ্যাকাউন্টের প্রয়োজন হবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बिना अकाउंट बनाए भी तुरंत ऐप आज़मा सकते हैं। आपको अकाउंट की ज़रूरत सिर्फ़ तब पड़ेगी जब आप अपने परिवार को जोड़ना चाहेंगे।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以不用注册账户直接试用这款应用。只有在你想要邀请家人时才需要账户。"
          }
        }
      }
    },
    "onboarding_slide0_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemeinsam entspannt in den Tag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒にリラックスして一日を。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "एकत्र आरामात दिवसाची सुरुवात."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A relaxed start to the day, together."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокійний початок дня разом."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empezar el día juntos y relajados."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En rolig start på dagen sammen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniziare la giornata insieme e rilassati."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En lugn start på dagen tillsammans."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 편안하게 시작하는 하루."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Zäme entspannt in Tag."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "En rolig start på dagen sammen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güne birlikte huzurla başlamak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wspólny, spokojny początek dnia."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Zusammen janz entspannt in den Tach."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Gmiatlich zamma in da Dag."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng nhau thong thả bước vào ngày mới."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойное начало дня вместе."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencer la journée ensemble tout en douceur."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulai hari dengan santai bersama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samen ontspannen de dag in."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar o dia juntos e relaxados."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একসাথে শান্তিতে দিন শুরু করা।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक साथ सुकून से दिन की शुरुआत।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "一起轻松开启新的一天。"
          }
        }
      }
    },
    "onboarding_slide0_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Stress, kein Chaos. FamWake sorgt dafür, dass alle entspannt in den Tag starten – ganz von allein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言い争いも、バタバタもなし。FamWakeがおまかせで、みんながリラックスして一日を始められるようサポートします。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणताही वाद नाही, कोणताही गोंधळ नाही. FamWake हे सुनिश्चित करते की प्रत्येकाच्या दिवसाची सुरुवात आरामात होईल – तेही आपोआप."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No arguments, no chaos. FamWake makes sure everyone starts the day relaxed – all by itself."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодних суперечок, жодного хаосу. FamWake гарантує, що кожен почне день розслаблено – повністю самостійно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin discusiones, sin caos. FamWake se asegura de que todos empiecen el día relajados, por sí sola."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen diskussioner, intet kaos. FamWake sørger for, at alle starter dagen afslappet – helt af sig selv."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente discussioni, niente caos. FamWake fa in modo che tutti inizino la giornata rilassati – in modo del tutto automatico."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga diskussioner, inget kaos. FamWake ser till att alla börjar dagen avslappnat – helt av sig självt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아침마다 다툴 일도, 정신없을 일도 없습니다. FamWake가 모두의 편안한 하루 시작을 알아서 챙겨줍니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kä Diskussione, kän Stress. FamWake sorgt defür, dass alli entspannt in Tag starte – ganz vo elei."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen diskusjoner, ikke noe kaos. FamWake sørger for at alle starter dagen avslappet – helt av seg selv."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tartışma yok, kaos yok. FamWake herkesin güne rahat başlamasını sağlar – tamamen kendi kendine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadnych kłótni, żadnego chaosu. FamWake dba o to, by każdy zaczął dzień zrelaksowany – zupełnie automatycznie."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Gekeife, kein Chaos. FamWake sorgt dafür, dat alle entspannt inne Tag starten – vollautomatisch."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Koi Diskussiona, koi Chaos. FamWake sorgt drfür, dass älle entspannt in Tag starta – ganz vo alloi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tranh cãi, không hỗn loạn. FamWake đảm bảo mọi người bắt đầu ngày mới một cách thư giãn – hoàn toàn tự động."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никаких споров, никакого хаоса. FamWake обеспечивает спокойное начало дня для всей семьи – полностью автоматически."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fini les disputes, fini le chaos. FamWake s'assure que tout le monde commence la journée de façon détendue – automatiquement."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa perdebatan, tanpa kekacauan. FamWake memastikan semua orang memulai hari dengan santai – dengan sendirinya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen geruzie, geen chaos. FamWake zorgt ervoor dat iedereen ontspannen aan de dag begint – helemaal vanzelf."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem brigas, sem caos. O FamWake garante que todo mundo comece o dia relaxado – de forma totalmente automática."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো ঝামেলা বা বিশৃঙ্খলা নেই। FamWake নিশ্চিত করে যে সবার দিনটা খুব শান্তিতে শুরু হয় – একদম নিজে থেকেই।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई बहस नहीं, कोई अफ़रातफ़री नहीं। FamWake यह सुनिश्चित करता है कि सबकी सुबह आराम से शुरू हो – वह भी अपने आप।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "告别争吵与混乱。FamWake 让全家人都能轻松开始新的一天——一切全自动。"
          }
        }
      }
    },
