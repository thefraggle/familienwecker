    "error_create_family_rate_limit": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast in letzter Zeit zu viele Familien erstellt. Bitte warte kurz und versuche es erneut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
