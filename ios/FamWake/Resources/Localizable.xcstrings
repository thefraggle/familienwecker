    "reorder_dialog_message": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll die neue Reihenfolge nur für heute (%@) oder für die ganze Woche gelten?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい注文は今日 (%@) のみに適用されるべきですか、それとも 1 週間全体に適用されるべきですか?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "नवीन ऑर्डर फक्त आज (%@) किंवा संपूर्ण आठवड्यासाठी लागू व्हायला हवी?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should the new order apply only to today (%@) or to the entire week?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Новий порядок має застосовуватися лише до сьогодні (%@) чи до всього тижня?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿El nuevo orden debería aplicarse solo a hoy (%@) o a toda la semana?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skal den nye ordre kun gælde for i dag (%@) eller for hele ugen?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nuovo ordine dovrebbe applicarsi solo a oggi (%@) o all'intera settimana?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ska den nya beställningen endast gälla idag (%@) eller hela veckan?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 주문은 오늘(%@)에만 적용해야 합니까, 아니면 일주일 전체에 적용해야 합니까?"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll die neue Reihenfolge nur für heute (%@) oder für die ganze Woche gelten?"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Skal den nye bestillingen bare gjelde i dag (%@) eller hele uken?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni emir yalnızca bugün (%@) için mi yoksa tüm hafta için mi geçerli olacak?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy nowe zamówienie powinno dotyczyć tylko dnia dzisiejszego (%@), czy całego tygodnia?"
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll die neue Reihenfolge nur für heute (%@) oder für die ganze Woche gelten?"
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll die neue Reihenfolge nur für heute (%@) oder für die ganze Woche gelten?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đơn hàng mới chỉ áp dụng cho hôm nay (%@) hay cho cả tuần?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Должен ли новый заказ применяться только к сегодняшнему дню (%@) или ко всей неделе?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle commande doit-elle s'appliquer uniquement à aujourd'hui (%@) ou à toute la semaine ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah pesanan baru hanya berlaku untuk hari ini (%@) atau untuk seluruh minggu?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Moet de nieuwe bestelling alleen voor vandaag (%@) of voor de hele week gelden?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova ordem deve ser aplicada apenas a hoje (%@) ou à semana inteira?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন অর্ডারটি কি শুধুমাত্র আজকের (%@) বা পুরো সপ্তাহে প্রযোজ্য হবে?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या नया आदेश केवल आज (%@) पर लागू होना चाहिए या पूरे सप्ताह पर?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "新订单应该仅适用于今天 (%@) 还是整周？"
          }
        }
      }
    },
