    "validation_latest_before_earliest": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবচেয়ে দেরিতে ওঠার সময়টি আগে ওঠার সময়ের পরে হতে হবে।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den seneste opvågningstid skal være efter den tidligste opvågningstid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die späteste Weckzeit muss nach der frühesten Weckzeit liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The latest wake-up time must be after the earliest wake-up time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora más tardía para despertar debe ser después de la hora más temprana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'heure de réveil la plus tardive doit être après l'heure la plus tôt."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Di spötesti Weckziit mues nach de früehste Weckziit sii."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "देर से उठने का समय, जल्दी उठने के समय के बाद का होना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu bangun paling lambat harus setelah waktu bangun paling awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orario di sveglia più tardi deve essere successivo a quello prima possibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最も遅い起床時間は、最も早い起床時間より後にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 늦은 기상 시간은 가장 빠른 기상 시간보다 늦어야 합니다."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Die späteste Zeit muss nach der frühesten sein, logisch oder?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वांत उशिरा उठण्याची वेळ ही सर्वांत लवकर उठण्याच्या वेळेनंतर असणे आवश्यक आहे."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den seneste oppvåkningstiden må være etter den tidligste oppvåkningstiden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uiterste wektijd moet na de vroegste wektijd liggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpóźniejsza pora pobudki musi być po najwcześniejszej porze pobudki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário limite para acordar deve ser depois do horário mais cedo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самое позднее время должно быть после самого раннего."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Senaste väckningstid måste vara efter tidigaste väckningstid."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Di späteschte Weggzeit muass noch de früheschte sei."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En geç uyanma saati, en erken uyanma saatinden sonra olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Найпізніший час підйому має бути після найранішого."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ thức dậy muộn nhất phải sau giờ thức dậy sớm nhất."
          }
        },
        "zh": {
          "stringUnit": {
