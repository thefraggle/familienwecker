    "no_account": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনও কোন অ্যাকাউন্ট নেই? এখানে সাইন আপ করুন।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto endnu? Tilmeld dig her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Konto? Hier registrieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account yet? Sign up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Aún no tienes cuenta? Regístrate aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de compte ? Inscris-toi ici."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Na käs Konto? Da registriere."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक अकाउंट नहीं है? यहाँ साइन अप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum punya akun? Daftar di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora un account? Iscriviti qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだアカウントをお持ちではありませんか？ここから登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 계정이 없나요? 여기에서 가입하세요."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch kein Konto? Mach eins auf."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अजून खाते नाही? येथे साइन अप करा."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen konto ennå? Meld deg på her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen account? Meld je hier aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze konta? Zarejestruj się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não tem conta? Cadastre-se aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Еще нет аккаунта? Зарегистрируйтесь здесь."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget konto ännu? Anmäl dig här."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch koi Konto? Do registriera."
          }
        },
        "tr": {
          "stringUnit": {
