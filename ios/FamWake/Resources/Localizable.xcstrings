    "settings_battery_warning_text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handy könnte den Wecker verzögern oder blockieren, um Strom zu sparen. Bitte erlaube FamWake, im Hintergrund zu laufen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンの設定によって、アラームが遅れたり鳴らなかったりする場合があります。FamWakeがいつでも動けるように許可してください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा फोन बॅटरी वाचवण्यासाठी अलार्म थांबवू शकतो किंवा उशीर करू शकतो. कृपया FamWake ला बॅकग्राउंडमध्ये चालू राहू द्या."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone might delay or block the alarm to save battery. Please allow FamWake to run in the background."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш телефон може затримувати або блокувати будильник для економії заряду. Будь ласка, дозвольте FamWake працювати у фоновом режимі."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono podría retrasar o bloquear la alarma para ahorrar batería. Por favor, permite que FamWake funcione en segundo plano."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon kan forsinke eller blokere alarmen for at spare strøm. Tillad venligst FamWake at køre i baggrunden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono potrebbe ritardare o bloccare la sveglia per risparmiare batteria. Consenti a FamWake di funzionare in background."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon kan försena eller blockera larmet för att spara batteri. Låt FamWake köras i bakgrunden."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰이 배터리를 절약하기 위해 알람을 지연시키거나 차단할 수 있습니다. FamWake가 백그라운드에서 실행되도록 허용해 주세요."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Diis Handy chönnt de Wecker verzögere oder blockiere, zum Strom spare. Bitte erlaub FamWake, im Hindergrund z'laufe."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen din kan forsinke eller blokkere alarmen for å spare strøm. La FamWake kjøre i bakgrunnen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz şarjı korumak için alarmı geciktirebilir veya engelleyebilir. Lütfen FamWake'in arka planda çalışmasına izin verin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój telefon może opóźnić lub zablokować alarm, aby oszczędzać baterię. Pozwól aplikacji FamWake działać w tle."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Ey, dein Handy könnte den Wecker blockieren. Erlaub FamWake mal, im Hintergrund zu rödeln, sonst bimmelt da nix."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Dei Händy kennt da Wegger verzögera oder blockiera, om Strom zom schbara. Bitte lass FamWake im Hendergrond laufa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại của bạn có thể trì hoãn hoặc chặn báo thức để tiết kiệm pin. Vui lòng cho phép FamWake chạy ngầm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш телефон может задерживать или блокировать будильник для экономии заряда. Пожалуйста, разрешите FamWake работать в фоновом режиме."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton téléphone risque de bloquer le réveil pour économiser la batterie. Laisse FamWake fonctionner en arrière-plan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel Anda mungkin menunda atau memblokir alarm untuk menghemat baterai. Mohon izinkan FamWake berjalan di latar belakang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon kan de wekker vertragen of blokkeren om batterij te besparen. Sta FamWake toe om op de achtergrond te draaien."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu celular pode atrasar ou bloquear o alarme para economizar bateria. Por favor, permita que o FamWake rode em segundo plano."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফোন ব্যাটারি বাঁচাতে অ্যালার্ম ব্লক বা দেরি করতে পারে। দয়া করে FamWake-কে ব্যাকগ্রাউন্ডে চলার অনুমতি দিন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ोन बैटरी बचाने के लिए अलार्म को रोक या टाल सकता है। कृपया FamWake को बैकग्राउंड में चलने दें।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "为了省电，您的手机可能会延迟或阻止闹钟。请允许 FamWake 在后台运行。"
          }
        }
      }
    },
