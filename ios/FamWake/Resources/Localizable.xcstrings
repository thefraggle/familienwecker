    "settings_profile_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handy klingelt nur für die Person, die hier ausgewählt ist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンは、ここで選択した人の時間にだけ鳴ります。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा फोन फक्त येथे निवडलेल्या व्यक्तीसाठीच वाजेल."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone will only ring for the person selected here."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш телефон буде дзвонити тільки для вибраної тут людини."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono solo sonará para la persona seleccionada aquí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon ringer kun for den person, der er valgt her."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il telefono suonerà solo per la persona selezionata qui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon ringer bara för den person som valts här."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 선택한 사람의 시간에만 이 휴대폰의 알람이 울립니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Diis Handy lüütet nur für di da gwählti Person."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen din ringer bare for personen som er valgt her."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz yalnızca burada seçilen kişinin saatinde çalar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój telefon będzie dzwonił tylko dla wybranej tutaj osoby."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handy rappelt nur für dat Profil, wat de hier auswählst."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Dei Händy klinglet bloß für d'Person, die do gwählt isch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại của bạn sẽ chỉ reo báo thức cho người được chọn ở đây."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телефон будет звонить только для выбранного здесь человека."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton téléphone ne sonnera que pour la personne sélectionnée ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel Anda hanya akan berdering untuk orang yang dipilih di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon gaat alleen af voor het hier geselecteerde profiel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu celular vai tocar apenas para a pessoa selecionada aqui."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফোনটি শুধুমাত্র এখানে নির্বাচিত ব্যক্তির জন্যই বাজবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ चुने गए व्यक्ति के लिए ही आपका फ़ोन बजेगा।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "您的手机只会为您在此处选择的成员响铃。"
          }
        }
      }
    },
