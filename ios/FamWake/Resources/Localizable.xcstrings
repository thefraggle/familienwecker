    "tooltip_alarm_switch": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltest du deinen Wecker aus, passt die App sofort den Morgen für alle anderen an – so können sie länger schlafen oder eher ins Bad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームをオフにすると、アプリがすぐに家族みんなのスケジュールを更新し、他の人が少し長く寝られたり、早くバスルームに行けたりするようになります。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही तुमचा अलार्म बंद केल्यास, ॲप लगेच इतरांचे वेळापत्रक अपडेट करते - ज्यामुळे त्यांना थोडा वेळ जास्त झोपायला किंवा लवकर बाथरूमला जाता येते."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you turn off your alarm, the app instantly updates the morning plan for everyone else – giving them more sleep or an earlier bathroom slot."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви вимкнете свій будильник, додаток миттєво оновить ранок для всієї родини, дозволяючи іншим поспати довше або піти у ванну раніше."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apagas tu alarma, la app actualiza de inmediato el plan para todos los demás, permitiendo que duerman un poco más o vayan al baño antes."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du slukker din alarm, opdaterer appen straks morgenplanen for alle andre – så de får mere søvn eller en tidligere badeværelsestid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se spegni la tua sveglia, l'app aggiornerà subito il programma mattutino per gli altri, permettendo loro di dormire un po' di più o di andare in bagno prima."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du stänger av ditt larm uppdaterar appen direkt morgonen för hela familjen – vilket ger dem mer sömn eller en tidigare tid i badrummet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람을 끄면, 앱이 즉시 모두의 아침 일정을 업데이트하여 다른 사람들이 조금 더 자거나 화장실을 더 일찍 쓸 수 있게 해줍니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltisch diin Wecker uus, passt d'App sofort de Morge für d'ganzi Familie aa – so chönd si länger schlafe oder eher is Bad."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du slår av alarmen, vil appen oppdatere umiddelbart morgenen for hele familien – slik at de får mer søvn eller en tidligere tid på badet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmınızı kapatırsanız, uygulama herkesin sabah planını anında günceller – böylece diğerleri biraz daha fazla uyuyabilir veya banyoya daha erken girebilir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli wyłączysz swój alarm, aplikacja natychmiast aktualizuje plan na poranek dla wszystkich innych – dając im więcej snu lub wcześniejszą kolej w łazience."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Machse Wecker aus, is dat nich nur stumm – dat Ding rechnet alles um, damit der Rest länger ratzen kann."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Machsch da Wegger aus, passt d'App d'Morga-Plan für älle andere sofort aa – so kennet die lenger schlafa oder eher is Bad."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn tắt báo thức, ứng dụng sẽ cập nhật ngay lịch trình buổi sáng cho tất cả những người khác – giúp họ có thêm thời gian ngủ hoặc vào phòng tắm sớm hơn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы выключите свой будильник, приложение мгновенно обновит расписание для остальных – давая им возможность поспать подольше или пойти в ванную пораньше."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu éteins ton réveil, l'appli met immédiatement à jour le programme matinal pour les autres, leur permettant de dormir plus longtemps ou d'aller à la salle de bain plus tôt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda mematikan alarm, aplikasi akan langsung memperbarui jadwal pagi untuk orang lain – memberi mereka waktu tidur lebih lama atau jadwal mandi lebih awal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de wekker uitzet, past de app direct de ochtend voor het hele gezin aan – zodat anderen wat langer kunnen slapen of eerder naar de badkamer kunnen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você desligar o alarme, o aplicativo atualiza instantaneamente a manhã de todos – dando a eles mais tempo para dormir ou uma ida mais cedo ao banheiro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অ্যালার্ম বন্ধ করলে, অ্যাপটি সাথে সাথেই অন্যদের সকালের রুটিন আপডেট করে – যাতে তারা আরেকটু বেশি ঘুমাতে পারে বা আগে বাথরুমে যেতে পারে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप अपना अलार्म बंद कर देते हैं, तो ऐप तुरंत बाकी सब लोगों के सुबह का रूटीन अपडेट कर देगा – ताकि उन्हें थोड़ी और नींद मिल सके या वे जल्दी बाथरूम जा सकें।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您关掉闹钟，应用会立即更新其他人的时间——让他们可以多睡一会儿或更早去洗漱。"
          }
        }
      }
    },
    "tooltip_weekdays": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf die Tage, um verschiedene Zeiten einzustellen. Perfekt, wenn du an manchen Tagen im Home-Office bist und an anderen ins Büro fährst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曜日をタップして別々の時間を設定できます。在宅勤務の日と出社日がある場合に便利です。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "वेगवेगळ्या वेळा सेट करण्यासाठी दिवसांवर टॅप करा. जर तुम्ही काही दिवस घरून काम करत असाल आणि काही दिवस ऑफिसला जात असाल, तर हे खूप उपयुक्त आहे."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap on the days to set different times. Perfect if you work from home on some days and commute on others."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натискайте на дні тижня, щоб задати різний час. Ідеально, якщо в якісь дні ви працюєте вдома, а в інші – їдете в офіс."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca los días para establecer horas diferentes. Ideal si algunos días trabajas desde casa y otros tienes que ir a la oficina."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på dagene for at indstille forskellige tider. Perfekt, hvis du arbejder hjemmefra nogle dage og pendler andre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca i giorni per impostare orari diversi. Perfetto se alcuni giorni lavori da casa e altri vai in ufficio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på dagarna för att ställa in olika tider. Perfekt om du jobbar hemifrån vissa dagar och pendlar andra."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요일을 탭해서 다른 시간을 설정해 보세요. 재택근무하는 날과 회사에 가는 날이 다를 때 아주 편리합니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp uf d'Täg, zum verschideni Ziite iizstelle. Perfäkt, wänn du a mängne Täg im Home-Office bisch und a andere is Büro fahrsch."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på dagene for å angi forskjellige tider. Perfekt hvis du jobber hjemmefra noen dager og pendler andre dager."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Farklı saatler ayarlamak için günlere dokunun. Bazı günler evden çalışıp diğer günler ofise gidiyorsanız mükemmeldir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij dni tygodnia, aby ustawić różne godziny. Idealne, jeśli w niektóre dni pracujesz z domu, a w inne dojeżdżasz do biura."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Plan für de ganze Woche: Tipp auf die Tage. Läuft perfekt für Homeoffice oder Maloche."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp uff d'Däg für verschiedene Zeita. Subber gschickt, wenn d'mol Dahoim schaffsch ond mol naus muasch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào các ngày để đặt thời gian khác nhau. Hoàn hảo nếu bạn làm việc ở nhà vào một số ngày và đi làm vào những ngày khác."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимайте на дни недели, чтобы задать разное время. Идеально, если в какие-то дни вы работаете из дома, а в другие – едете в офис."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie sur les jours pour définir des horaires différents. Parfait si tu travailles de la maison certains jours et que tu vas au bureau les autres."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk hari untuk mengatur waktu yang berbeda. Cocok jika Anda bekerja dari rumah di hari tertentu dan ke kantor di hari lainnya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op de dagen om verschillende tijden in te stellen. Ideaal als je de ene dag thuiswerkt en de andere dag naar kantoor gaat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque nos dias para definir horários diferentes. Perfeito se você trabalha de casa em alguns dias e vai para o escritório em outros."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আলাদা দিনের জন্য আলাদা সময় দিতে দিনগুলোতে ট্যাপ করুন। ঘরে বসে কাজ বা অফিসে যাওয়ার দিনগুলোর জন্য দারুণ।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अलग-अलग समय सेट करने के लिए दिनों पर टैप करें। यह तब बहुत काम आता है जब आप कुछ दिन घर से काम करते हैं और कुछ दिन ऑफ़िस जाते हैं।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "点击星期几来设置不同的时间。非常适合居家办公和去公司打卡交替的日子。"
          }
        }
      }
    },
