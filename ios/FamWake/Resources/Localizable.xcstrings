    "empty_members_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer geht wann ins Badezimmer? Füge das erste Familienmitglied hinzu, damit FamWake eure Weckzeiten und die Badezimmer-Reihenfolge automatisch berechnen kann."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰がいつお風呂（洗面所）に行きますか？最初の家族を追加すると、FamWakeが起床時間と浴室の順番を自動的に計算します。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोण कधी बाथरूममध्ये जाणार? कुटुंबातील पहिल्या सदस्याला जोडा जेणेकरून FamWake तुमच्या उठण्याची वेळ आणि बाथरूमचा क्रम स्वयंचलितपणे मोजू शकेल pedig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who goes to the bathroom when? Add the first family member so FamWake can automatically calculate your wake-up times and bathroom schedule."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хто і коли йде до ванної кімнати? Додайте першого члена сім'ї, щоб FamWake міг автоматично розрахувати ваш час пробудження та чергу до ванної."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quién va al baño y cuándo? Añade al primer miembro de la familia para que FamWake possa calcular automáticamente vuestros horarios de mañana y el orden del baño."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem går på badeværelset hvornår? Tilføj det eerste familiemedlem, så FamWake automatisk kan beregne jeres vækketider og rækkefølge til badeværelset."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi va in bagno e quando? Aggiungi il primo membro della famiglia in modo che FamWake possa calcolare automaticamente i vostri orari di sveglia e l'ordine per il bagno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem går till badrummet när? Lägg till den första familjemedlemmen så dass FamWake automatiskt kan beräkna era väckningstider och badrumsordning."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누가 언제 화장실에 가나요? 첫 번째 가족 구성원을 추가하면 FamWake가 기상 시간과 화장실 순서를 자동으로 계산해 드립니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wär gaht wänn is Badzimmer? Füeg s erschte Familie-Mitgliid hinzue, demit FamWake eui Weckziite und d Badzimmer-Reihenfolg automatisch berächne cha."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem går på badet når? Legg til det første familiemedlemmet, slik at FamWake automatisk kan beregne våknetidene deres og rekkefølgen til badet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kim ne zaman banyoya gidiyor? FamWake'in uyanma saatlerinizi banyo sıranızı otomatik olarak hesaplayabilmesi için ilk aile üyesini ekleyin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kto i kiedy idzie do łazienki? Dodaj pierwszego członka rodziny, aby FamWake mógł automatycznie obliczyć Wasze godziny budzenia i kolejność korzystania z łazienki."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer geht wann ins Badezimmer? Pack das erste Familienmitglied rein, damit FamWake eure Weckzeiten und die Badezimmer-Reihenfolge automatisch ausrechnen kann."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer goht wann ens Bad? Do s erschte Familienmitglied drzua, damit FamWake eire Weckzeida ond d'Bad-Reihefolg automatisch berechna koh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ai vào phòng tắm khi nào? Hãy thêm thành viên đầu tiên trong gia đình để FamWake có thể tự động tính toán thời gian thức dậy và thứ tự sử dụng phòng tắm của bạn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто и когда идет в ванную? Добавьте первого члена семьи, чтобы FamWake мог автоматически рассчитать время пробуждения и очередь в ванную."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui va à la salle de bain et quand ? Ajoutez le premier membre de la famille pour que FamWake puisse calculer automatiquement vos heures de réveil et l'ordre de passage à la salle de bain."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siapa yang ke kamar mandi kapan? Tambahkan anggota keluarga pertama agar FamWake dapat menghitung waktu bangun dan urutan kamar mandi Anda secara otomatis."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie gaat wanneer naar de badkamer? Voeg het eerste familielid toe, zodat FamWake automatisch jullie wektijden en badkamervolgorde kan berekenen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem vai à casa de banho e quando? Adicione o primeiro membro da família para que o FamWake possa calcular automaticamente as vossas horas de acordar e a ordem da casa de banho."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কে কখন বাথরুমে যাবে? প্রথম পরিবারের सदस्यকে যুক্ত করুন যাতে FamWake স্বয়ংক্রিয়ভাবে আপনার ঘুম से ওঠার সময় এবং বাথরুমের ক্রম গণনা করতে পারে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कौन कब बाथरूम जाएगा? परिवार के पहले सदस्य को जोड़ें ताकि FamWake आपके जागने का समय और बाथरूम का क्रम स्वचालित रूप से गणना कर सके।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "谁什么时候进浴室？添加第一个家庭成员，让 FamWake 自动计算您的起床时间和浴室使用顺序。"
          }
        }
      }
    },
