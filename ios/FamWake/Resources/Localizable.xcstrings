        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा फोन अलार्म थांबवत आहे. तुम्ही वेळेवर उठू शकाल यासाठी कृपया FamWake ला अलार्म सेट करण्याची परवानगी द्या."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone is blocking the alarm. Please allow FamWake to schedule alarms so you wake up on time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш телефон блокує будильник. Будь ласка, дозвольте FamWake встановлювати будильники, щоб прокидатися вчасно."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu teléfono está bloqueando la alarma. Por favor, permite que FamWake programe alarmas para que te despiertes a tiempo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon blokerer alarmen. Tillad venligst FamWake at planlægge alarmer, så du vågner til tiden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo telefono sta bloccando la sveglia. Consenti a FamWake di impostare le sveglie per svegliarti in orario."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din telefon blockerar larmet. Tillåt FamWake att ställa in larm så att du vaknar i tid."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰이 알람을 차단하고 있습니다. 제시간에 일어날 수 있도록 FamWake의 알람 설정을 허용해 주세요."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Diis Handy blockiert de Wecker. Bitte erlaub FamWake, Wecker z'stelle, demit du pünktlich uufwachsch."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonen din blokkerer alarmen. Tillat FamWake å planlegge alarmer, slik at du våkner i tide."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuz alarmı engelliyor. Zamanında uyanabilmek için lütfen FamWake'e alarm kurma izni verin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój telefon blokuje alarm. Zezwól aplikacji FamWake na planowanie alarmów, abyś mógł obudzić się na czas."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Android blockiert den Wecker. Bitte erlaub FamWake dat Bimmeln in de Einstellungen."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Dei Händy blockiert da Wegger. Bitte erlaub FamWake, Wegger zom stalla, damit d'pünktlich uffwachsch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điện thoại của bạn đang chặn báo thức. Vui lòng cho phép FamWake cài đặt báo thức để bạn có thể thức dậy đúng giờ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш телефон блокирует будильник. Пожалуйста, разрешите FamWake устанавливать будильники, чтобы просыпаться вовремя."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton téléphone bloque le réveil. Autorise FamWake à programmer des réveils pour te lever à l'heure."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponsel Anda memblokir alarm. Tolong izinkan FamWake mengatur alarm agar Anda bangun tepat waktu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je telefoon blokkeert de wekker. Geef FamWake toestemming om wekkers in te stellen, zodat je op tijd wakker wordt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O celular está bloqueando o alarme. Por favor, permita que o FamWake programe alarmes para você acordar na hora certa."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ফোন অ্যালার্ম ব্লক করছে। আপনি যেন সময়মতো ঘুম থেকে উঠতে পারেন, তাই FamWake-কে অ্যালার্ম সেট করার অনুমতি দিন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ोन अलार्म को रोक रहा है। कृपया FamWake को अलार्म सेट करने दें ताकि आप समय पर उठ सकें।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "您的手机拦截了闹钟。请允许 FamWake 设置闹钟，确保您能准时起床。"
          }
        }
      }
    },
