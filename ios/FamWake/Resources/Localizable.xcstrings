    "error_alarm_permission": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যেন সময়মতো উঠতে পারেন, তাই ফোনের সেটিংসে অ্যালার্মের অনুমতি দিন।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillad venligst alarmer i din telefons indstillinger, så din telefon kan vække dig til tiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte erlaube Wecker in deinen Einstellungen, damit dein Handy dich pünktlich wecken kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please allow alarms in your phone settings so your phone can wake you up on time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, permite las alarmas en los ajustes de tu teléfono para que pueda despertarte a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorise les réveils dans les paramètres de ton téléphone pour qu'il puisse te réveiller à l'heure."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte erlaub Wecker i diine Iistellige, demit diis Handy dich pünktlich wecke chan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया अपने फ़ोन की सेटिंग्स में अलार्म को मंज़ूरी दें ताकि आपका फ़ोन आपको समय पर जगा सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tolong izinkan alarm di pengaturan ponsel agar ponsel dapat membangunkan Anda tepat waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti le sveglie nelle impostazioni del telefono in modo da poterti svegliare in orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間通りに起きられるように、スマートフォンの設定でアラームを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제시간에 일어날 수 있도록 휴대폰 설정에서 알람을 허용해 주세요."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Mach ma inne Einstellungen die Alarme an, sonst verpennt der Wecker dat."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही वेळेवर उठू शकाल यासाठी कृपया फोन सेटिंग्जमध्ये अलार्मला परवानगी द्या."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vennligst tillat alarmer i telefoninnstillingene slik at telefonen kan vekke deg i tide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta a.u.b. wekkers toe in je telefooninstellingen, zodat je telefoon je op tijd wakker kan maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól na alarmy w ustawieniach telefonu, aby telefon obudził Cię na czas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, permita os alarmes nas configurações do seu celular para que ele possa te acordar na hora certa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, разрешите будильники в настройках вашего телефона, чтобы он мог будить вас вовремя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillåt larm i dina telefoninställningar så att telefonen kan väcka dig i tid."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte erlaub Wegger in de Eistellonga, damit dei Händy di pünktlich wegga ko."
