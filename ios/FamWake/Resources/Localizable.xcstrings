        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근에 가족 그룹을 너무 많이 만드셨습니다. 조금만 기다렸다가 다시 시도해 주세요."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
