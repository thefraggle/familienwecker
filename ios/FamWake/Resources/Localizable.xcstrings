    "notif_member_joined_body": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পরিবারের রুটিনে নতুন কেউ যুক্ত হয়েছে।"
