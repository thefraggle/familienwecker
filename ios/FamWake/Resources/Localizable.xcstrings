    "empty_schedule_description": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An diesem Tag klingelt kein Wecker. Zeit zum Entspannen und Ausschlafen!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この日はアラームが鳴りません。リラックスしてゆっくり寝ましょう！"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "या दिवशी कोणताही अलार्म वाजणार नाही. आराम करण्याची आणि झोपण्याची वेळ!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No alarm will ring on this day. Time to relax and sleep in!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цього дня будильник не дзвонитиме. Час розслабитися та виспатися!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna alarma sonará este día. ¡Es hora de relajarse y dormir!"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der ringer ingen alarm på denne dag. Tid til at slappe af og sove længe!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna sveglia suonerà in questo giorno. Tempo di rilassarsi e dormire di più!"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget alarm ringer den här dagen. Tid att koppla av och sova ut!"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이날은 알람이 울리지 않습니다. 푹 쉬고 늦잠을 잘 시간입니다!"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "A däm Tag lüütet kein Wecker. Ziit zum Entspanne und Uusschlafe!"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen alarm ringer på denne dagen. Tid for å slappe av og sove lenge!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tarihte hiçbir alarm çalmayacak. Dinlenme ve uyuma zamanı!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego dnia nie zadzwoni żaden budzik. Czas na relaks i sen!"
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "An dem Tag klingelt nix. Zeit zum Entspannen und Ausschlafen!"
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "An dem Dag schellt koin Wecker. Zeit zom Entspanna ond Ausschlofa!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẽ không có chuông báo thức nào reo vào ngày này. Đã đến lúc thư giãn và ngủ nướng!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот день будильник не прозвенит. Время расслабиться и выспаться!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun réveil ne sonnera ce jour-là. C'est le moment de se détendre et de faire la grasse matinée !"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada alarm yang berdering pada hari ini. Waktunya bersantai dan tidur nyenyak!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op deze dag gaat er geen wekker af. Tijd om te ontspannen und uit te slapen!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum alarme tocará neste dia. Tempo para relaxar e dormir até mais tarde!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই দিনে কোনো অ্যালার্ম বাজবে না। বিশ্রাম নেওয়ার এবং ঘুমানোর সময়!"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस दिन कोई अलार्म नहीं बजेगा। आराम करने और देर तक सोने का समय!"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "这一天没有闹钟响起。放松睡个懒觉吧！"
          }
        }
      }
    },
