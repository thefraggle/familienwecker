    "settings_evening_reminder_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert dich abends daran, deinen Weckplan für morgen zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds you in the evening to check your alarm schedule for tomorrow."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder dig om aftenen om at tjekke din vækkeplan for i morgen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te recuerda por la noche que revises tu horario de despertador para mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te rappelle le soir de vérifier ton planning de réveil pour demain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कल के अलार्म शेड्यूल की जांच करने के लिए आपको शाम को याद दिलाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengingatkanmu di malam hari untuk memeriksa jadwal alarm besok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti ricorda alla sera di controllare il tuo programma della sveglia per domani."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜に明日のアラームスケジュールを確認するよう通知します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일의 알람 일정을 확인하도록 저녁에 알려줍니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उद्याच्या अलार्मचे वेळापत्रक तपासण्यासाठी तुम्हाला संध्याकाळी आठवण करून देते."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnert je er 's avonds aan om je wekschema voor morgen te controleren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Minner deg om kvelden på å sjekke vekkeplanen for i morgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomina wieczorem o sprawdzeniu planu budzenia na jutro."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembra você à noite de verificar seu horário de alarme para amanhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминает вечером проверить расписание будильника на завтра."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminner dig på kvällen om att kontrollera ditt väckningsschema för i morgon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yarınki alarm programınızı kontrol etmeniz için akşamları hatırlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нагадує ввечері перевірити розклад будильника на завтра."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhắc bạn vào buổi tối kiểm tra lịch báo thức cho ngày mai."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "在晚间提醒你查看明天的闹钟计划。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在晚间提醒你查看明天的闹钟计划。"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগামীকালের অ্যালার্ম সময়সূচী পরীক্ষা করার জন্য আপনাকে সন্ধ্যায় মনে করিয়ে দেয়।"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinneret di am Abig draa, din Weckplan für morn z'überprüefe."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert dich ovends dran, dinge Weckplan för morje ze pröfe."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert di am Obend dra, dein Weckplan für morge zum brüfe."
          }
        }
      }
    },
