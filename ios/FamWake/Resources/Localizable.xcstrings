          }
        }
      }
    },
    "tooltip_drag_handle": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কে আগে বাথরুমে যাবে তা বদলাতে কোনো নাম চেপে ধরে ওপরে বা নিচে টানুন। সময়গুলো সাথে সাথেই আপডেট হয়ে যাবে।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og hold et navn for at trække det op eller ned. Dette ændrer, hvem der bruger badeværelset først. Tiderne opdateres med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Namen gedrückt und ziehe ihn nach oben oder unten. Das ändert, wer zuerst ins Bad geht. Der Plan aktualisiert sich sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold a name to drag it up or down. This changes who goes to the bathroom first. The times will update instantly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un nombre para moverlo arriba o abajo. Así cambias quién entra primero al baño. Los tiempos se actualizarán al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens ton doigt sur un nom pour le faire glisser vers le haut ou le bas. Cela change l'ordre de passage dans la salle de bain. Le planning se met à jour instantanément."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt en Name druckt und zieh en ufe oder abe. Das änderet, wer z'erst is Bad gaht. De Plan aktualisiert sich sofort."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाथरूम में पहले कौन जाएगा, यह बदलने के लिए किसी नाम को दबाकर रखें और ऊपर या नीचे खींचे। समय तुरंत अपडेट हो जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan dan tahan nama untuk menggesernya ke atas atau ke bawah. Ini mengubah siapa yang ke kamar mandi lebih dulu. Waktu akan langsung diperbarui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un nome per trascinarlo su o giù. Questo cambia l'ordine di chi va in bagno per primo. Gli orari si aggiorneranno all'istante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を長押しして上下に移動させると、バスルームを使う順番を変えられます。時間は自動的に更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 길게 눌러 위아래로 끌어다 놓으세요. 화장실을 먼저 쓸 사람의 순서가 바뀝니다. 시간이 즉시 업데이트됩니다."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt son Ding gedrückt und zieh dat rum. Der Rechner taktet dat sofort neu durch."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बाथरूममध्ये कोण आधी जाईल हे बदलण्यासाठी नावावर दाबा आणि ते वर किंवा खाली ओढा. वेळापत्रक लगेच अपडेट होईल."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk og hold på et navn for å dra det opp eller ned. Dette endrer hvem som går på badet først. Tidene oppdateres umiddelbart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een naam ingedrukt om deze omhoog of omlaag te slepen. Dit verandert wie er als eerste naar de badkamer gaat. Het schema past zich direct aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij i przytrzymaj imię, aby przesunąć je w górę lub w dół. To zmienia, kto idzie pierwszy do łazienki. Czasy zaktualizują się natychmiast."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione e segure um nome para arrastá-lo para cima ou para baixo. Isso muda quem vai primeiro ao banheiro. Os horários são atualizados na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте имя, чтобы перетащить его вверх или вниз. Это меняет порядок очереди в ванную. Расписание обновится моментально."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och håll på ett namn för att dra det upp eller ner. Detta ändrar vem som går till badrummet först. Tiderna uppdateras direkt."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt so an Nama ond zieh'n nuff oder na. Des änderet, wer z'erscht ins Bad goht. Dr Plan rechnet sich sofort nei."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banyoya kimin önce gireceğini değiştirmek için bir isme basılı tutun ve yukarı veya aşağı sürükleyin. Saatler anında güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і утримуйте ім'я, щоб перетягнути його вгору або вниз. Це змінює чергу до ванної. Час оновиться миттєво."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn và giữ một cái tên để kéo nó lên hoặc xuống. Việc này thay đổi xem ai sẽ vào phòng tắm trước. Thời gian sẽ cập nhật ngay lập tức."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "长按并拖动名字可以更改顺序。这会决定谁先去洗手间。时间会立即自动更新。"
          }
        }
      }
    },
