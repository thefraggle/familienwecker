        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람 일정을 확인하도록 저녁에 알려줍니다."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्मचे वेळापत्रक तपासण्यासाठी तुम्हाला संध्याकाळी आठवण करून देते."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinnert je er 's avonds aan om je wekschema te controleren."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Minner deg om kvelden på å sjekke vekkeplanen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomina wieczorem o sprawdzeniu planu budzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembra você à noite de verificar seu horário de alarme."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминает вечером проверить расписание будильника."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Påminner dig på kvällen om att kontrollera ditt väckningsschema."
          }
        },
        "tr": {
