    "settings_exact_alarm_warning_text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handy blockiert den Wecker. Bitte erlaube FamWake, Wecker zu stellen, damit du pünktlich aufwachst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンがアラームをブロックしています。時間通りに起きられるようにアラームを許可してください。"
