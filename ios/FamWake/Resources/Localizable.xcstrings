    "settings_steal_text": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ইতিমধ্যেই নেওয়া হয়েছে। আপনি কি এটি আপনার জন্য ব্যবহার করতে চান?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er allerede valgt. Vil du bruge denne profil?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits vergeben. Möchtest du es für dich übernehmen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already taken. Do you want to take it over?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está asignado. ¿Quieres usar este perfil?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est déjà utilisé. Veux-tu utiliser ce profil ?"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isch scho vergäh. Wottsch es für dich übernäh?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पहले ही किसी ने चुन लिया है। क्या आप इसे अपने लिए इस्तेमाल करना चाहते हैं?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil %@ sudah dipakai orang lain. Apakah Anda ingin menggunakannya?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è già in uso. Vuoi usare questo profilo per te?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はすでに選ばれています。このプロフィールを自分のものとして使いますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 프로필은 이미 선택되어 있습니다. 이 프로필을 내 프로필로 사용하시겠습니까?"
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat sich schon einer gekrallt. Willze dat für dich haben?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ आधीच निवडलेले आहे. तुम्हाला हे प्रोफाईल वापरायचे आहे का?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er allerede valgt. Vil du bruke denne profilen?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is al in gebruik. Wil je dit profiel gebruiken?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil %@ jest już zajęty. Czy chcesz go używać dla siebie?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil %@ já está em uso. Quer usar este perfil para você?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профиль %@ уже занят. Хотите использовать его для себя?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ används redan. Vill du använda den här profilen?"
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ isch scho vergäba. Woisch es für di nemma?"
