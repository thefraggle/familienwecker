    "delete_member_text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du %@ wirklich aus der Familie löschen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当に%@を家族から削除しますか？"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला %@ यांना कुटुंबातून खरोखरच हटवायचे आहे का?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove %@ from the family?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дійсно видалити %@ із сім'ї?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿De verdad quieres eliminar a %@ de la familia?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil fjerne %@ fra familien?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero rimuovere %@ dalla famiglia?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill ta bort %@ från familjen?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가족에서 %@님을 정말로 삭제하시겠습니까?"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wottsch %@ würkli us de Familie lösche?"
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil fjerne %@ fra familien?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adlı kişiyi aileden çıkarmak istediğinize emin misiniz?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć %@ z rodziny?"
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Soll %@ echt ausser Truppe fliegen?"
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtesch %@ echt aus der Familie lescha?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa %@ khỏi gia đình không?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить %@ из семьи?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Es-tu sûr(e) de vouloir supprimer %@ de la famille ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus %@ dari keluarga?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je %@ uit de familie wilt verwijderen?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja remover %@ da família?"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি %@-কে পরিবার থেকে সরিয়ে দিতে চান?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई %@ को परिवार से हटाना चाहते हैं?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要将 %@ 从家庭中删除吗？"
          }
        }
      }
    },
