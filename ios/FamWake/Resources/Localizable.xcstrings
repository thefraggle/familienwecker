    "permission_fullscreen_message": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনাকে ঠিকমতো জাগানোর জন্য FamWake-এর অনুমতি প্রয়োজন। সিস্টেম সেটিংসে এর অনুমতি দিন।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake har brug for tilladelse til at vække dig ordentligt. Tillad venligst dette i din telefons indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake braucht die Erlaubnis, dich richtig zu wecken. Bitte erlaube dies in den Einstellungen deines Handys."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake needs permission to wake you up properly. Please allow this in your phone settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake necesita permiso para despertarte correctamente. Por favor, permítelo en los ajustes de tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake a besoin d'une autorisation pour te réveiller correctement. Merci de l'activer dans les paramètres de ton téléphone."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake bruucht d'Erlaubnis, dich richtig z'wecke. Bitte erlaub das i de Iistellige vo diim Handy."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake को आपको सही से जगाने के लिए परमिशन की ज़रूरत है। कृपया अपने फ़ोन की सेटिंग्स में इसे चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake perlu izin untuk membangunkan Anda dengan benar. Tolong izinkan ini di pengaturan ponsel Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake ha bisogno del permesso per svegliarti correttamente. Autorizzalo nelle impostazioni del tuo telefono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間通りに起こすために権限が必要です。スマートフォンの設定で許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람이 제대로 울리려면 권한이 필요합니다. 휴대폰 설정에서 이를 허용해 주세요."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App braucht Rechte, damit se dich ordentlich ausm Bett schmeißen kann. Mach dat ma inne Einstellungen."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला योग्य वेळी उठवण्यासाठी FamWake ला परवानगी आवश्यक आहे. कृपया फोन सेटिंग्जमध्ये याची परवानगी द्या."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake trenger tillatelse til å vekke deg ordentlig. Vennligst tillat dette i telefoninnstillingene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake heeft toestemming nodig om je goed wakker te maken. Sta dit a.u.b. toe in de instellingen van je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake potrzebuje uprawnień, aby móc Cię prawidłowo obudzić. Zezwól na to w ustawieniach telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O FamWake precisa de permissão para te acordar direito. Por favor, permita isso nas configurações do seu celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake требует разрешения, чтобы правильно вас будить. Пожалуйста, разрешите это в настройках вашего телефона."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake behöver behörighet för att väcka dig ordentligt. Tillåt detta i dina telefoninställningar."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake braucht d'Erlaubnis, di richtig wachzommacha. Bittschön in de Eistellonga erlaubä."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake'in sizi düzgün bir şekilde uyandırabilmesi için izne ihtiyacı var. Lütfen bunu telefonunuzun ayarlarından etkinleştirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake потребує дозволу, щоб правильно вас будити. Будь ласка, дозвольте це в налаштуваннях вашого телефону."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake cần quyền để đánh thức bạn đúng cách. Vui lòng cho phép điều này trong cài đặt điện thoại của bạn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake 需要获得权限才能正确地叫醒您。请在手机设置中允许此操作。"
          }
        }
      }
    },
