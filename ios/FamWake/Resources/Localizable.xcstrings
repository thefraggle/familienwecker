    "notif_schedule_changed_body": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Weckzeiten haben sich geändert. Öffne die App, um deine neue Zeit zu sehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる時間が変更されました。アプリを開いて新しい時間を確認してください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "उठण्याच्या वेळा बदलल्या आहेत. तुमची नवीन वेळ पाहण्यासाठी ॲप उघडा."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wake-up times have changed. Open the app to check your new time."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час пробудження змінився. Відкрийте додаток, щоб перевірити ваш новий час."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas de despertar han cambiado. Abre la app para ver tu nueva hora."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vækketiderne er ændret. Åbn appen for at tjekke din nye tid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli orari della sveglia sono cambiati. Apri l'app per controllare il tuo nuovo orario."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Väckningstiderna har ändrats. Öppna appen för att se din nya tid."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어나는 시간이 변경되었습니다. 앱을 열어서 새로운 시간을 확인해 보세요."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "D'Weckziite händ sich gänderet. Mach d'App uuf, zum diini neui Ziit gseh."
          }
        },
        "no": {
          "stringUnit": {
