    "login_google_error_no_account": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Google-Konto gefunden. Bitte melde dich in den Einstellungen bei Google an oder nutze E-Mail und Passwort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleアカウントが見つかりません。スマートフォンの設定からログインするか、メールアドレスを使ってください。"
          }
