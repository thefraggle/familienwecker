        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account Google trovato. Accedi dalle impostazioni del telefono o usa l'email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Googleアカウントが見つかりません。スマートフォンの設定からログインするか、メールアドレスを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 계정을 찾을 수 없습니다. 휴대폰 설정에서 Google에 로그인하거나 이메일과 비밀번호를 사용해 주세요."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Google-Konto auffem Gerät. Meld dich inne Einstellungen an oder nimm E-Mail."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "कोणतेही Google खाते आढळले नाही. कृपया फोन सेटिंग्जमधून साइन इन करा किंवा ईमेल वापरा."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Google-konto funnet. Logg på via telefoninnstillingene eller bruk e-post."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen Google-account gevonden op dit apparaat. Log in op Google in je telefooninstellingen of gebruik e-mail en wachtwoord."
