    "offline_write_hint": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Internet. Deine Änderungen werden gespeichert, sobald du wieder online bist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネットがありません。オンラインに戻り次第、変更が保存されます。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट नाही. तुम्ही परत ऑनलाइन होताच तुमचे बदल सेव्ह केले जातील."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet. Your changes will be saved as soon as you are back online."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає інтернету. Ваші зміни будуть збережені, як тільки ви знову будете в мережі."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin internet. Tus cambios se guardarán en cuanto vuelvas a estar conectado."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet internet. Dine ændringer gemmes, så snart du er online igen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione. Le tue modifiche verranno salvate non appena sarai di nuovo online."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget internet. Dina ändringar sparas så snart du är online igen."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷이 없습니다. 다시 연결되면 변경사항이 저장됩니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Käs Internet. Diini Änderige wärded gspeicheret, sobald du wieder online bisch."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen internett. Endringene dine vil bli lagret så snart du er tilbake online."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnternet yok. Değişiklikleriniz çevrimiçi olduğunuzda hemen kaydedilecektir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak internetu. Twoje zmiany zostaną zapisane, gdy tylko znów będziesz online."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Netz grade. Speichern wa, wennse wieder da bist."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Kois Netz do. Deine Änderonga werdat gspeichert, sobalds wieder goht."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có mạng. Các thay đổi của bạn sẽ được lưu ngay khi bạn có mạng trở lại."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет интернета. Ваши изменения будут сохранены, как только вы снова будете в сети."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d'Internet. Tes modifications seront enregistrées dès que tu seras de nouveau en ligne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada internet. Perubahan Anda akan disimpan segera setelah Anda kembali online."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen internet. Je wijzigingen worden bewaard zodra je weer online bent."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem internet. Suas alterações serão salvas assim que você estiver online novamente."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইন্টারনেট নেই। অনলাইনে এলেই আপনার পরিবর্তনগুলো সেভ হয়ে যাবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट नहीं है। जैसे ही आप ऑनलाइन आएँगे, आपके बदलाव सेव हो जाएँगे।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "没有网络。当您重新上线后，更改将立即保存。"
          }
        }
      }
    },
