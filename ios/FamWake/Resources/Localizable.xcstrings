    "main_no_profile_warning_desc": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte wähle in den Einstellungen, wer du bist, damit der Wecker für dich klingeln kann."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームが鳴るように、設定で「自分」のプロフィールを選択してください。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्यासाठी अलार्म वाजू शकेल यासाठी कृपया सेटिंग्जमध्ये तुमचे प्रोफाइल निवडा."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please select who you are in the settings so your phone rings for you."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, виберіть свій профіль у налаштуваннях, щоб телефон дзвонив саме для вас."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, selecciona quién eres en los ajustes para que el teléfono suene para ti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg venligst hvem du er i indstillingerne, så din telefon ringer for dig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona chi sei nelle impostazioni, così il telefono suonerà per te."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj din profil i inställningarna så att larmet kan ringa för dig."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람이 울릴 수 있도록 설정에서 자신이 누구인지 선택해 주세요."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte wähl i de Iistellige diis Profil uus, demit de Wecker für dich lüüte chan."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg profilen din i innstillingene slik at telefonen kan ringe for deg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun sizin için çalabilmesi adına lütfen ayarlardan kendi profilinizi seçin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz w ustawieniach, kim jesteś, aby telefon mógł dzwonić dla Ciebie."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Such dir inne Einstellungen dein Profil raus, sonst bimmelt dat Handy hier für nix."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte wähl in de Eistellonga dei Profil aus, damit de Wegger für di klingla ko."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng chọn xem bạn là ai trong cài đặt để điện thoại có thể báo thức cho bạn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, выберите свой профиль в настройках, чтобы телефон звонил именно для вас."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionne qui tu es dans les paramètres pour que ton téléphone puisse sonner pour toi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Silakan pilih siapa Anda di pengaturan agar ponsel dapat berdering untuk Anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer je profiel in de instellingen zodat de wekker voor jou kan afgaan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, selecione seu perfil nas configurações para que o celular toque para você."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেটিংসে আপনি কে তা বেছে নিন, যাতে অ্যালার্ম আপনার জন্য বাজে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया सेटिंग्स में अपनी प्रोफ़ाइल चुनें ताकि आपका फ़ोन आपके लिए अलार्म बजा सके।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "请在设置中选择您的个人资料，以便手机能为您响起闹钟。"
          }
        }
      }
    },
    "main_unclaimed_first_title": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %@ klingelt kein Wecker!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のアラームが鳴りません！"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ साठी, कोणताही अलार्म वाजणार नाही!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No alarm will ring for %@!"
          }
        },
        "uk": {
