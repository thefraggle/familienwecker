    "onboarding_slide1_body": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফিস, স্কুল বা বাড়ি থেকে কাজ – FamWake পুরো পরিবারের জন্য ঘুম থেকে ওঠা এবং বাথরুম ব্যবহারের নিখুঁত সময় হিসাব করে দেয়। সকালের ভিড় ছাড়াই।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uanset om det er kontor, skole eller hjemmearbejdsplads – FamWake beregner den perfekte vække- og badetid for hele familien. Uden kø om morgenen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Egal ob Büro, Schule oder Home-Office – FamWake berechnet die perfekte Weck- und Badzeit für die ganze Familie. Ohne Stau am Morgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether office, school, or home office – FamWake calculates the perfect wake-up and bathroom time for the whole family. Without the morning traffic jam."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya sea oficina, escuela o teletrabajo: FamWake calcula la hora perfecta de despertarse y de baño para toda la familia. Sin atascos por la mañana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que ce soit au bureau, à l'école ou en télétravail, FamWake calcule l'heure idéale de réveil et de salle de bain pour toute la famille. Sans embouteillage le matin."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake findt für jede i de Familie di perfäkti Weckziit – passend zu Badziit, Zmorge und Abfahrt. Käs Gedrängel meh am Lavabo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफिस, स्कूल या वर्क फ्रॉम होम – FamWake पूरे परिवार के लिए उठने और बाथरूम के इस्तेमाल का सही समय कैलकुलेट करता है। सुबह की भीड़-भाड़ के बिना।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baik itu kantor, sekolah, atau bekerja dari rumah – FamWake menghitung waktu bangun dan mandi yang sempurna untuk seluruh keluarga. Tanpa antrean di pagi hari."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ufficio, scuola o smart working non importa: FamWake calcola l'orario perfetto per la sveglia e il bagno per tutta la famiglia. Senza code al mattino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフィス、学校、またはホームオフィスに関係なく、FamWakeは家族全員にとって最適な起床時間とバスタイムを計算します。朝の渋滞はもうありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사무실, 학교 또는 재택근무 등 상황에 관계없이 FamWake는 온 가족을 위한 완벽한 기상 및 욕실 사용 시간을 계산해 줍니다. 아침의 혼잡함은 이제 그만."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejal ob Maloche, Schule oder Home-Office – FamWake rechnet dir die perfekte Weck- und Badzeit für die ganze Bagage aus. Ohne Stau am Morgen."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफिस, शाळा किंवा घरून काम असो – FamWake संपूर्ण कुटुंबासाठी उठण्याची आणि बाथरूमची योग्य वेळ मोजतो. सकाळच्या गर्दीशिवाय."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enten det er kontor, skole eller hjemmekontor – FamWake beregner den perfekte vekke- og badetiden for hele familien. Uten kø om morgenen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Of het nu kantoor, school of thuiswerken is – FamWake berekent de perfecte wek- en badkamertijd voor het hele gezin. Zonder file in de ochtend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biuro, szkoła czy home office – FamWake oblicza idealny czas pobudki i łazienki dla całej rodziny. Bez porannych korków."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja escritório, escola ou home office – o FamWake calcula o horário perfeito de acordar e do banho para toda a família. Sem congestionamentos de manhã."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Офис, школа или удаленка — FamWake рассчитает идеальное время пробуждения и ванной для всей семьи. Без утренних пробок."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Oavsett om det är kontor, skola eller hemmakontor – FamWake beräknar den perfekta väcknings- och badtiden för hela familjen. Utan kö på morgonen."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake findt für jedes Familiamitglied d'perfekte Weggzeit – abgstimmt uffs Bad, Frühstück ond d'Abfahrt. Koi Gedrängel meh am Waschbegga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İster ofis, ister okul veya evden çalışma olsun - FamWake tüm aile için mükemmel uyanma ve banyo saatini hesaplar. Sabahları sıra beklemeden."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Офіс, школа чи віддалена робота — FamWake розрахує ідеальний час пробудження та ванної кімнати для всієї родини. Без ранкових черг."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dù là văn phòng, trường học hay làm việc tại nhà – FamWake tính toán thời gian thức dậy và dùng phòng tắm hoàn hảo cho cả gia đình. Không còn tắc nghẽn buổi sáng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "FamWake 会根据洗漱、早餐和出门时间，为每个人找到最完美的起床时间。洗手间再也不用排长队了。"
          }
        }
      }
    },
