    "onboarding_slide5_body": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অ্যাকাউন্ট ছাড়াই অ্যাপটি ব্যবহার করে দেখতে পারেন। আপনি যখন পরিবারকে আমন্ত্রণ জানাতে চাইবেন, তখনই অ্যাকাউন্টের প্রয়োজন হবে।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan prøve appen med det samme uden en konto. Du behøver kun en, når du vil invitere din familie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die App direkt ohne Konto ausprobieren. Du brauchst erst eins, wenn du deine Familie einladen möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can try the app right away without an account. You only need one when you want to invite your family."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes probar la app ahora mismo sin tener cuenta. Solo necesitarás una cuando quieras invitar a tu familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux essayer l'appli tout de suite sans avoir de compte. Tu n'en auras besoin que lorsque tu voudras inviter ta famille."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Du chasch d'App diräkt ohni Konto uusprobiere. Eises bruuchsch erst, wänn du diini Familie iilade wottsch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बिना अकाउंट बनाए भी तुरंत ऐप आज़मा सकते हैं। आपको अकाउंट की ज़रूरत सिर्फ़ तब पड़ेगी जब आप अपने परिवार को जोड़ना चाहेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat langsung mencoba aplikasinya tanpa akun. Anda hanya memerlukan akun saat ingin mengundang keluarga Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi provare l'app fin da subito senza un account. Ne avrai bisogno solo quando vorrai invitare la tua famiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントがなくてもすぐにアプリを試せます。アカウントが必要になるのは、家族を招待する時だけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 없어도 바로 앱을 사용해 볼 수 있습니다. 가족을 초대하고 싶을 때만 계정을 만드시면 됩니다."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör ma, du kanns die App direkt ohne Anmeldung ausprobieren. Ein Konto brauchsse erst, wenn de deine Familie einläds."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही खाते न बनवताही ॲप लगेच वापरून पाहू शकता. जेव्हा तुम्हाला तुमच्या कुटुंबाला आमंत्रित करायचे असेल तेव्हाच तुम्हाला खात्याची आवश्यकता असेल."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan prøve appen med en gang uten konto. Du trenger bare en når du vil invitere familien din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de app meteen uitproberen zonder account. Je hebt er pas een nodig als je je familie wilt uitnodigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wypróbować aplikację od razu, bez posiadania konta. Będziesz go potrzebować dopiero wtedy, gdy będziesz chciał zaprosić swoją rodzinę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode testar o app na hora sem uma conta. Você só vai precisar de uma quando quiser convidar sua família."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете попробовать приложение прямо сейчас без аккаунта. Он понадобится вам только тогда, когда вы захотите пригласить свою семью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan prova appen direkt utan ett konto. Du behöver bara ett när du vill bjuda in din familj."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannsch d'App direkt ohne Aameldung ausprobiera. A Konto brauchsch erscht, wenn de dei Familie eiladsch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap oluşturmadan uygulamayı hemen deneyebilirsin. Sadece ailenizi davet etmek istediğinizde bir hesaba ihtiyacınız olacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете спробувати додаток відразу без облікового запису. Він знадобиться лише тоді, коли ви захочете запросити свою сім'ю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể dùng thử ứng dụng ngay mà không cần tài khoản. Bạn chỉ cần tài khoản khi muốn mời gia đình của mình tham gia."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以不用注册账户直接试用这款应用。只有在你想要邀请家人时才需要账户。"
          }
        }
      }
    },
