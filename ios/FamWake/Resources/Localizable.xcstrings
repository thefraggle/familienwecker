      }
    },
    "tooltip_awake_button": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon wach? Tippe hier, um deinen Wecker für heute auszumachen – deine Bad-Zeit bleibt für dich reserviert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "早く起きましたか？ここをタップして今日のアラームをオフにしてください。あなたのバスルームの時間は確保されたままです。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "लवकर जागे झालात? तुमचा आजचा अलार्म थांबवण्यासाठी येथे टॅप करा – तुमची बाथरूमची वेळ तुमच्यासाठी राखीव राहील."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awake early? Tap here to turn off your alarm for today – your bathroom time stays reserved for you."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прокинулися раніше? Натисніть тут, щоб вимкнути будильник на сьогодні – ваш час у ванній залишиться зарезервованим для вас."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te has despertado antes? Toca aquí para apagar tu alarma de hoy; tu tiempo en el baño seguirá reservado para ti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vågen tidligt? Tryk her for at slukke din alarm for i dag – din tid på badeværelset forbliver reserveret til dig."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sveglio/a in anticipo? Tocca qui per spegnere la sveglia per oggi: il tuo tempo in bagno resterà riservato a te."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaken tidigt? Tryck här för att stänga av ditt larm för idag – din tid i badrummet förblir reserverad för dig."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일찍 일어나셨나요? 여기를 탭해서 오늘 알람을 끄세요. 화장실 사용 시간은 그대로 확보됩니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Scho wach? Tipp da, zum diin Wecker für hüt uuszmache – diini Bad-Ziit bliibt für dich reserviert."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Våken tidlig? Trykk her for å slå av alarmen for i dag – tiden din på badet forblir reservert for deg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erken mi uyandınız? Bugünlük alarmınızı kapatmak için buraya dokunun – banyo sıranız sizin için ayrılı kalır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obudziłeś się wcześnie? Dotknij tutaj, aby wyłączyć alarm na dziś – Twój czas w łazience pozostanie zarezerwowany dla Ciebie."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon wach? Klick hier, dann hält der Wecker die Fresse. Deine Bad-Zeit bleibt trotzdem für dich."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Scho uffgwacht? Tipp do drauf, zom de Wegger für heit wegmacha – dei Bad-Zeit bleibt trotzdem reserviert."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thức dậy sớm? Nhấn vào đây để tắt báo thức hôm nay – thời gian vào phòng tắm vẫn sẽ được giữ lại cho bạn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проснулись раньше? Нажмите здесь, чтобы выключить будильник на сегодня – ваше время в ванной останется зарезервированным для вас."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà debout ? Appuie ici pour désactiver ton réveil pour aujourd'hui – ton temps dans la salle de bain te reste réservé."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun lebih awal? Ketuk di sini untuk mematikan alarm Anda hari ini – waktu kamar mandi Anda akan tetap dipesan untuk Anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al vroeg wakker? Tik hier om je wekker voor vandaag uit te zetten – jouw tijd in de badkamer blijft gewoon voor jou gereserveerd."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acordou mais cedo? Toque aqui para desligar seu alarme de hoje – seu tempo no banheiro continua reservado para você."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগেই উঠে গেছেন? আজকের জন্য অ্যালার্ম বন্ধ করতে এখানে ট্যাপ করুন – আপনার বাথরুমের সময় আপনার জন্যই থাকবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप जल्दी उठ गए? आज के लिए अपना अलार्म बंद करने के लिए यहाँ टैप करें – आपका बाथरूम का समय आपके लिए रिज़र्व रहेगा।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "早起了吗？点击此处关闭今天的闹钟——您的洗漱时间仍将为您保留。"
          }
        }
      }
    },
    "tooltip_drag_handle": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halte einen Namen gedrückt und ziehe ihn nach oben oder unten. Das ändert, wer zuerst ins Bad geht. Der Plan aktualisiert sich sofort."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を長押しして上下に移動させると、バスルームを使う順番を変えられます。時間は自動的に更新されます。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "बाथरूममध्ये कोण आधी जाईल हे बदलण्यासाठी नावावर दाबा आणि ते वर किंवा खाली ओढा. वेळापत्रक लगेच अपडेट होईल."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press and hold a name to drag it up or down. This changes who goes to the bathroom first. The times will update instantly."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і утримуйте ім'я, щоб перетягнути його вгору або вниз. Це змінює чергу до ванної. Час оновиться миттєво."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado un nombre para moverlo arriba o abajo. Así cambias quién entra primero al baño. Los tiempos se actualizarán al instante."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk og hold et navn for at trække det op eller ned. Dette ændrer, hvem der bruger badeværelset først. Tiderne opdateres med det samme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto un nome per trascinarlo su o giù. Questo cambia l'ordine di chi va in bagno per primo. Gli orari si aggiorneranno all'istante."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck och håll på ett namn för att dra det upp eller ner. Detta ändrar vem som går till badrummet först. Tiderna uppdateras direkt."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 길게 눌러 위아래로 끌어다 놓으세요. 화장실을 먼저 쓸 사람의 순서가 바뀝니다. 시간이 즉시 업데이트됩니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt en Name druckt und zieh en ufe oder abe. Das änderet, wer z'erst is Bad gaht. De Plan aktualisiert sich sofort."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk og hold på et navn for å dra det opp eller ned. Dette endrer hvem som går på badet først. Tidene oppdateres umiddelbart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Banyoya kimin önce gireceğini değiştirmek için bir isme basılı tutun ve yukarı veya aşağı sürükleyin. Saatler anında güncellenir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij i przytrzymaj imię, aby przesunąć je w górę lub w dół. To zmienia, kto idzie pierwszy do łazienki. Czasy zaktualizują się natychmiast."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt son Ding gedrückt und zieh dat rum. Der Rechner taktet dat sofort neu durch."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Halt so an Nama ond zieh'n nuff oder na. Des änderet, wer z'erscht ins Bad goht. Dr Plan rechnet sich sofort nei."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn và giữ một cái tên để kéo nó lên hoặc xuống. Việc này thay đổi xem ai sẽ vào phòng tắm trước. Thời gian sẽ cập nhật ngay lập tức."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте имя, чтобы перетащить его вверх или вниз. Это меняет порядок очереди в ванную. Расписание обновится моментально."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintiens ton doigt sur un nom pour le faire glisser vers le haut ou le bas. Cela change l'ordre de passage dans la salle de bain. Le planning se met à jour instantanément."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan dan tahan nama untuk menggesernya ke atas atau ke bawah. Ini mengubah siapa yang ke kamar mandi lebih dulu. Waktu akan langsung diperbarui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd een naam ingedrukt om deze omhoog of omlaag te slepen. Dit verandert wie er als eerste naar de badkamer gaat. Het schema past zich direct aan."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione e segure um nome para arrastá-lo para cima ou para baixo. Isso muda quem vai primeiro ao banheiro. Os horários são atualizados na hora."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কে আগে বাথরুমে যাবে তা বদলাতে কোনো নাম চেপে ধরে ওপরে বা নিচে টানুন। সময়গুলো সাথে সাথেই আপডেট হয়ে যাবে।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाथरूम में पहले कौन जाएगा, यह बदलने के लिए किसी नाम को दबाकर रखें और ऊपर या नीचे खींचे। समय तुरंत अपडेट हो जाएगा।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "长按并拖动名字可以更改顺序。这会决定谁先去洗手间。时间会立即自动更新。"
          }
        }
      }
    },
    "tooltip_wake_window": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib uns ein Zeitfenster. Die App findet den perfekten Moment zum Wecken, damit du nicht vor dem Bad warten musst."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる時間の枠を教えてください。バスルームを待たなくていい完璧なタイミングをアプリが見つけます。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आम्हाला एक वेळेची मर्यादा द्या. ॲप तुम्हाला उठवण्यासाठी योग्य वेळ शोधेल जेणेकरून तुम्हाला बाथरूमसाठी वाट पाहावी लागणार नाही."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give us a time window. The app will find the perfect moment to wake you up so you don't have to wait for the bathroom."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте нам часове вікно. Додаток знайде ідеальний момент, щоб розбудити вас, і вам не доведеться чекати на ванну."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Danos un margen de tiempo. La app encontrará el momento perfecto para despertarte y que no tengas que esperar para ir al baño."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv os et tidsvindue. Appen finder det perfekte øjeblik at vække dig, så du ikke behøver at vente på badeværelset."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacci una finestra di tempo. L'app troverà il momento perfetto per svegliarti senza farti aspettare per il bagno."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge oss ett tidsfönster. Appen hittar det perfekta ögonblicket att väcka dig så att du inte behöver vänta på badrummet."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어날 수 있는 시간 범위를 알려주세요. 아무도 화장실을 기다리지 않도록 앱이 가장 좋은 타이밍을 찾아냅니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gih ois es Ziitfänster. D'App findt de perfäkti Momänt zum Wecke, demit du nöd vorem Bad warte muesch."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi oss et tidsvindu. Appen vil finne det perfekte tidspunktet for å vekke deg, slik at du ikke trenger å vente på badet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bize bir zaman aralığı verin. Uygulama, banyoyu beklemek zorunda kalmayacağınız en mükemmel anı bulup sizi uyandırır."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj nam przedział czasowy. Aplikacja znajdzie idealny moment, aby Cię obudzić, żebyś nie musiał czekać na łazienkę."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib uns nen Zeitraum. Die App macht dat schon passend, dat keiner meckert."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib ons a Fenschderle o. D'App findt dr perfekte Moment zom Wegga, damit d'net vorm Bad warta muasch."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy cho chúng tôi một khoảng thời gian. Ứng dụng sẽ tìm ra khoảnh khắc hoàn hảo để đánh thức bạn, để bạn không phải đợi phòng tắm."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте нам временное окно. Приложение найдет идеальный момент, чтобы разбудить вас, и вам не придется ждать ванную."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne-nous une plage horaire. L'appli trouvera le moment parfait pour te réveiller afin que tu n'aies pas à attendre pour la salle de bain."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri kami rentang waktu. Aplikasi ini akan menemukan momen yang tepat untuk membangunkan Anda sehingga Anda tidak perlu mengantre kamar mandi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef ons een tijdsvenster. De app vindt het perfecte moment daarbinnen om je wakker te maken, zodat je niet op de badkamer hoeft te wachten."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dê-nos uma janela de tempo. O aplicativo encontrará o momento perfeito para te acordar, para que você não precise esperar pelo banheiro."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমাদের একটি সময় দিন। অ্যাপটি এর মধ্যে সঠিক সময়টি বেছে নেবে যাতে কাউকে বাথরুমের জন্য অপেক্ষা করতে না হয়।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें एक टाइम विंडो (समय-सीमा) दें। ऐप आपको जगाने के लिए सबसे सही समय ढूँढ लेगा ताकि आपको बाथरूम के लिए इंतज़ार न करना पड़े।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "给我们一个时间范围。应用会找到最完美的叫醒时刻，让您无需排队等洗手间。"
          }
        }
      }
    },
    "tooltip_bathroom": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei hier realistisch. Deine Bad-Zeit gibt das Tempo für alle anderen vor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここは現実的な時間を設定してください。あなたのバスルームの時間が、他の全員の朝のペースを決めます。"
