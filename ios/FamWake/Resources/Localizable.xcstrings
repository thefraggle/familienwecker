        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Diis Passwort isch z'eifach. Bitte bruuch mindistens 8 Zeiche und Sonderzeiche."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Passordet ditt er for enkelt å gjette. Bruk minst 8 tegn og noen spesialsymboler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifrenizin tahmin edilmesi çok kolay. Lütfen en az 8 karakter ve bazı özel semboller kullanın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje hasło jest zbyt proste. Użyj co najmniej 8 znaków i kilku symboli specjalnych."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Ey, dat Passwort is wie Pappe. Nimm mindestens 8 Zeichen und nen paar Sonderdinger."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Des Passwort isch z'oifach. Nimm midischtens 8 Zeiche ond a baar Sondrzeiche."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mật khẩu quá dễ đoán. Vui lòng sử dụng ít nhất 8 ký tự và thêm ký tự đặc biệt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш пароль слишком легко угадать. Используйте как минимум 8 символов и специальные знаки."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton mot de passe est trop facile à deviner. Utilise au moins 8 caractères et des symboles spéciaux."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata sandi Anda terlalu mudah ditebak. Harap gunakan minimal 8 karakter dan beberapa simbol khusus."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je wachtwoord is te makkelijk te raden. Gebruik minstens 8 tekens en enkele speciale symbolen."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua senha é muito fácil de adivinhar. Por favor, use pelo menos 8 caracteres e alguns símbolos especiais."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার পাসওয়ার্ড খুব সহজ। দয়া করে অন্তত ৮টি অক্ষর এবং কিছু বিশেষ চিহ্ন ব্যবহার করুন।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पासवर्ड बहुत आसान है। कृपया कम से कम 8 कैरेक्टर और कुछ स्पेशल सिंबल का इस्तेमाल करें।"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "您的密码太容易被猜到。请使用至少 8 个字符并包含一些特殊符号。"
          }
        }
      }
    },
