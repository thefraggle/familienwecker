        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Акаунт Google не знайдено. Будь ласка, увійдіть через налаштування телефону або використовуйте email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna cuenta de Google. Por favor, inicia sesión en Google en los ajustes de tu teléfono o usa correo y contraseña."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Google-konto fundet. Log ind via din telefons indstillinger, eller brug e-mail."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account Google trovato. Accedi dalle impostazioni del telefono o usa l'email."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget Google-konto hittades. Logga in på Google i telefonens inställningar eller använd e-post och lösenord."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 계정을 찾을 수 없습니다. 휴대폰 설정에서 Google에 로그인하거나 이메일과 비밀번호를 사용해 주세요."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Käs Google-Konto gfunde. Bitte mäld dich i de Iistellige bi Google aa oder nutz E-Mail und Passwort."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen Google-konto funnet. Logg på via telefoninnstillingene eller bruk e-post."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Google hesabı bulunamadı. Lütfen telefon ayarlarından giriş yapın veya e-postanızı kullanın."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono konta Google. Zaloguj się w ustawieniach telefonu lub użyj e-maila."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Google-Konto auffem Gerät. Meld dich inne Einstellungen an oder nimm E-Mail."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Koi Google-Konto uff dem Grät gfonda. Bitte meld di in de Eistellonga bei Google aa oder nutz E-Mail ond Passwort."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy tài khoản Google. Vui lòng đăng nhập trong cài đặt điện thoại hoặc dùng email."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве не найден аккаунт Google. Пожалуйста, войдите в Google в настройках вашего телефона или используйте email и пароль."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte Google trouvé. Connecte-toi via les paramètres du téléphone ou utilise un e-mail."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
