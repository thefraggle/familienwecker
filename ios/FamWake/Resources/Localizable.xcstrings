    "registration_disclaimer": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাইন আপ করার মাধ্যমে, আপনি %@ এবং %@ স্বীকার করছেন।"
