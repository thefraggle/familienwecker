    "settings_delete_family_dialog_text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchtest du diese Familie wirklich dauerhaft löschen? Alle Mitglieder, Zeiten und Einstellungen verschwinden für alle. Das kann nicht rückgängig gemacht werden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この家族を完全に削除しますか？メンバー、時間、設定など、全員のデータが消去されます。この操作は元に戻せません。"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्हाला खरोखर हे कुटुंब कायमचे हटवायचे आहे का? सर्वांसाठी सदस्य, वेळा आणि सेटिंग्ज कायमच्या पुसल्या जातील. हे परत मिळवता येणार नाही."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this family forever? All members, times, and settings will be gone for everyone. This cannot be undone."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете назавжди видалити цю сім'ю? Усі учасники, час та налаштування зникнуть для всіх. Цю дію не можна скасувати."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres eliminar esta familia de forma permanente? Se eliminarán todos los miembros, horas y ajustes para todos. Esto no se puede deshacer."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på, at du vil slette denne familie permanent? Alle medlemmer, tider og indstillinger vil være væk for alle. Dette kan ikke fortrydes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi eliminare questa famiglia per sempre? Tutti i membri, gli orari e le impostazioni spariranno per tutti. Questa azione è irreversibile."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill ta bort den här familjen permanent? Alla medlemmar, tider och inställningar försvinner för alla. Detta kan inte ångras."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 가족을 영구적으로 삭제하시겠습니까? 모든 멤버, 시간, 설정이 모두에게서 지워집니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wottsch die Familie würkli duurhaft lösche? Alli Mitgliider, Ziite und Iistellige verschwinded für alli. Das cha nöd rückgängig gmacht wärde."
          }
        },
        "no": {
          "stringUnit": {
            "state": "translated",
            "value": "Er du sikker på at du vil slette denne familien permanent? Alle medlemmer, tider og innstillinger vil bli borte for alle. Dette kan ikke angres."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu aileyi kalıcı olarak silmek istediğinize emin misiniz? Tüm üyeler, saatler ve ayarlar herkes için silinecektir. Bu işlem geri alınamaz."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz trwale usunąć tę rodzinę? Wszyscy członkowie, czasy i ustawienia znikną dla każdego. Tego działania nie można cofnąć."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisse sicher? Dann is der ganze Schmu für alle wech. Dat krisse nich mehr zurück, wa."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisch dir g'wiß, dass d'die Familie ganz für emmer lescha woisch? Älles goht für älle verlora. Des ka ma net zruggmacha."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa vĩnh viễn gia đình này không? Tất cả thành viên, lịch trình và cài đặt sẽ bị xóa đối với mọi người. Thao tác này không thể hoàn tác."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите навсегда удалить эту семью? Все участники, расписания и настройки будут удалены для всех. Это действие нельзя отменить."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer cette famille pour toujours ? Tous les membres, horaires et paramètres disparaîtront pour tout le monde. C'est irréversible."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus keluarga ini secara permanen? Semua anggota, waktu, dan pengaturan akan hilang untuk semua orang. Ini tidak dapat dibatalkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je deze familie permanent wilt verwijderen? Alle leden, tijden en instellingen worden voor iedereen verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir esta família para sempre? Todos os membros, horários e configurações sumirão para todo mundo. Isso não pode ser desfeito."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কি পরিবারটিকে স্থায়ীভাবে মুছে ফেলতে চান? সব সদস্য, সময় এবং সেটিংস সবার জন্য মুছে যাবে। এটি আর ফিরিয়ে আনা যাবে না।"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई इस परिवार को हमेशा के लिए हटाना चाहते हैं? सभी सदस्य, समय और सेटिंग्स सभी के लिए मिट जाएँगी। इसे वापस नहीं लाया जा सकता।"
          }
        },
