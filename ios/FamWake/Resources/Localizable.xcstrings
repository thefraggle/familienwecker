            "value": "Vekketidene er endret. Åpne appen for å sjekke den nye tiden din."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyanma saatleri değişti. Yeni saatini kontrol etmek için uygulamayı aç."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czasy pobudki uległy zmianie. Otwórz aplikację, aby sprawdzić swój nowy czas."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Weckzeiten ham sich geändert. Mach die App auf und guck, wann de raus musst."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
