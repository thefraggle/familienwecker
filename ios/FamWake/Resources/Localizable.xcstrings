        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonunuzun sizi zamanında uyandırabilmesi için lütfen ayarlardan alarmlara izin verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
