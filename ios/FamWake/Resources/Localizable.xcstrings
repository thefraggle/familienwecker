    "schedule_message_no_valid": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সবাইকে ঠিকমতো জাগানোর জন্য সময়গুলো খুব বেশি মিলে যাচ্ছে।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiderne overlapper for meget til at lave en god tidsplan."
