    "tooltip_alarm_sound": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নিজের ওঠার শব্দ বেছে নিতে এখানে ট্যাপ করুন – সাধারণ শব্দের বদলে আপনার পছন্দের মিউজিক দিন।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk her for at vælge din personlige opvågningslyd – vælg din yndlingsmusik i stedet for standard bippet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe hier für deinen persönlichen Weckton – wähle deine Lieblingsmusik statt dem normalen Piepen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap here to choose your personal wake-up sound – pick your favorite music instead of the normal beeping."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca aquí para elegir tu propio sonido de despertar; pon tu música favorita en lugar del pitido normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuie ici pour choisir ta propre sonnerie de réveil – mets ta musique préférée au lieu du bip classique."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipp da druff für diin persönliche Weckton – wähl diini Lieblingsmusig statt em normale Piepse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने उठने की आवाज़ चुनने के लिए यहाँ टैप करें – साधारण बीप की जगह अपना पसंदीदा म्यूज़िक लगाएँ。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk di sini untuk memilih suara bangun pribadi Anda – gunakan musik favorit Anda daripada bunyi bip biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca qui per scegliere la tua suoneria personale – scegli la tua musica preferita invece del classico bip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここをタップして自分用のアラーム音を選んでください。普通のピッという音の代わりに好きな音楽を設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기를 탭해서 나만의 알람 소리를 골라보세요. 딱딱한 비프음 대신 좋아하는 음악으로 아침을 시작하세요."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Druck hier, um deinen eigenen Weckton auszusuchen – nimm wat Geiles statt dem Standardgebimmel."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा स्वतःचा अलार्मचा आवाज निवडण्यासाठी येथे टॅप करा – नेहमीच्या आवाजाऐवजी तुमचे आवडते संगीत निवडा."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk her for å velge din personlige oppvåkningslyd – velg favorittmusikken din i stedet for den vanlige pipelyden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik hier om je persoonlijke wekkergeluid te kiezen – neem je favoriete muziek in plaats van het standaard gepiep."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij tutaj, aby wybrać swój osobisty dźwięk budzenia – wybierz swoją ulubioną muzykę zamiast zwykłego pikania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque aqui para escolher seu som de alarme pessoal – escolha sua música favorita em vez do toque normal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите здесь, чтобы выбрать ваш личный звук будильника – выберите любимую музыку вместо обычного писка."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck här för att välja ditt personliga väckningsljud – välj din favoritmusik istället för det vanliga pipandet."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Druck do, om dein persönliche Weggton auszusuacha – nemm dei Lieblingsmusik statt am normale Gepiepse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel uyanma sesini seçmek için buraya dokun – normal bip sesi yerine en sevdiğin müziği seç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть тут, щоб вибрати ваш особистий звук будильника – оберіть улюблену музику замість звичайного пищання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấn vào đây để chọn âm thanh đánh thức của riêng bạn – chọn bản nhạc yêu thích thay vì tiếng bíp thông thường."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "点击此处选择您的专属起床铃声——用您最喜欢的音乐代替默认的哔哔声。"
          }
        }
      }
    },
    "tooltip_alarm_switch": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অ্যালার্ম বন্ধ করলে, অ্যাপটি সাথে সাথেই অন্যদের সকালের রুটিন আপডেট করে – যাতে তারা আরেকটু বেশি ঘুমাতে পারে বা আগে বাথরুমে যেতে পারে।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du slukker din alarm, opdaterer appen straks morgenplanen for alle andre – så de får mere søvn eller en tidligere badeværelsestid."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltest du deinen Wecker aus, passt die App sofort den Morgen für alle anderen an – so können sie länger schlafen oder eher ins Bad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you turn off your alarm, the app instantly updates the morning plan for everyone else – giving them more sleep or an earlier bathroom slot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apagas tu alarma, la app actualiza de inmediato el plan para todos los demás, permitiendo que duerman un poco más o vayan al baño antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu éteins ton réveil, l'appli met immédiatement à jour le programme matinal pour les autres, leur permettant de dormir plus longtemps ou d'aller à la salle de bain plus tôt."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltisch diin Wecker uus, passt d'App sofort de Morge für d'ganzi Familie aa – so chönd si länger schlafe oder eher is Bad."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप अपना अलार्म बंद कर देते हैं, तो ऐप तुरंत बाकी सब लोगों के सुबह का रूटीन अपडेट कर देगा – ताकि उन्हें थोड़ी और नींद मिल सके या वे जल्दी बाथरूम जा सकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda mematikan alarm, aplikasi akan langsung memperbarui jadwal pagi untuk orang lain – memberi mereka waktu tidur lebih lama atau jadwal mandi lebih awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se spegni la tua sveglia, l'app aggiornerà subito il programma mattutino per gli altri, permettendo loro di dormire un po' di più o di andare in bagno prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アラームをオフにすると、アプリがすぐに家族みんなのスケジュールを更新し、他の人が少し長く寝られたり、早くバスルームに行けたりするようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알람을 끄면, 앱이 즉시 모두의 아침 일정을 업데이트하여 다른 사람들이 조금 더 자거나 화장실을 더 일찍 쓸 수 있게 해줍니다."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Machse Wecker aus, is dat nich nur stumm – dat Ding rechnet alles um, damit der Rest länger ratzen kann."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही तुमचा अलार्म बंद केल्यास, ॲप लगेच इतरांचे वेळापत्रक अपडेट करते - ज्यामुळे त्यांना थोडा वेळ जास्त झोपायला किंवा लवकर बाथरूमला जाता येते."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du slår av alarmen, vil appen oppdatere umiddelbart morgenen for hele familien – slik at de får mer søvn eller en tidligere tid på badet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de wekker uitzet, past de app direct de ochtend voor het hele gezin aan – zodat anderen wat langer kunnen slapen of eerder naar de badkamer kunnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli wyłączysz swój alarm, aplikacja natychmiast aktualizuje plan na poranek dla wszystkich innych – dając im więcej snu lub wcześniejszą kolej w łazience."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você desligar o alarme, o aplicativo atualiza instantaneamente a manhã de todos – dando a eles mais tempo para dormir ou uma ida mais cedo ao banheiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы выключите свой будильник, приложение мгновенно обновит расписание для остальных – давая им возможность поспать подольше или пойти в ванную пораньше."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du stänger av ditt larm uppdaterar appen direkt morgonen för hela familjen – vilket ger dem mer sömn eller en tidigare tid i badrummet."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Machsch da Wegger aus, passt d'App d'Morga-Plan für älle andere sofort aa – so kennet die lenger schlafa oder eher is Bad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarmınızı kapatırsanız, uygulama herkesin sabah planını anında günceller – böylece diğerleri biraz daha fazla uyuyabilir veya banyoya daha erken girebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви вимкнете свій будильник, додаток миттєво оновить ранок для всієї родини, дозволяючи іншим поспати довше або піти у ванну раніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn tắt báo thức, ứng dụng sẽ cập nhật ngay lịch trình buổi sáng cho tất cả những người khác – giúp họ có thêm thời gian ngủ hoặc vào phòng tắm sớm hơn."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您关掉闹钟，应用会立即更新其他人的时间——让他们可以多睡一会儿或更早去洗漱。"
          }
        }
      }
    },
    "tooltip_awake_button": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগেই উঠে গেছেন? আজকের জন্য অ্যালার্ম বন্ধ করতে এখানে ট্যাপ করুন – আপনার বাথরুমের সময় আপনার জন্যই থাকবে।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vågen tidligt? Tryk her for at slukke din alarm for i dag – din tid på badeværelset forbliver reserveret til dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schon wach? Tippe hier, um deinen Wecker für heute auszumachen – deine Bad-Zeit bleibt für dich reserviert."
