    "settings_steal_text": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist bereits vergeben. Möchtest du es für dich übernehmen?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」はすでに選ばれています。このプロフィールを自分のものとして使いますか？"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ आधीच निवडलेले आहे. तुम्हाला हे प्रोफाईल वापरायचे आहे का?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is already taken. Do you want to take it over?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профіль %@ вже кимось вибраний. Бажаєте використовувати його для себе?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya está asignado. ¿Quieres usar este perfil?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er allerede valgt. Vil du bruge denne profil?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
