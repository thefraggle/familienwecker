    "notif_permission_desc": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটিফিকেশন বন্ধ করলে অ্যালার্ম ঠিকমতো কাজ নাও করতে পারে। এগুলো চালু রাখুন।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du slår notifikationer fra, virker din alarm muligvis ikke ordentligt. Lad dem venligst være slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du Benachrichtigungen ausschaltest, funktioniert dein Wecker vielleicht nicht richtig. Bitte lass sie an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you turn off notifications, your alarm might not work properly. Please leave them on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apagas las notificaciones, puede que la alarma no funcione bien. Por favor, déjalas encendidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu désactives les notifications, ton réveil risque de ne pas fonctionner correctement. Merci de les laisser activées."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wänn du Benachrichtigunge uusschaltisch, funktioniert diin Wecker villicht nöd richtig. Bitte laa si aa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप नोटिफ़िकेशन बंद कर देते हैं, तो हो सकता है आपका अलार्म सही से काम न करे। कृपया इन्हें चालू रहने दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika Anda mematikan notifikasi, alarm Anda mungkin tidak berfungsi dengan baik. Tolong biarkan tetap menyala."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivi le notifiche, la sveglia potrebbe non funzionare correttamente. Per favore, lasciale attive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知をオフにすると、アラームが正しく鳴らない場合があります。オンのままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 끄면 알람이 제대로 작동하지 않을 수 있습니다. 켜두시는 것을 권장합니다."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Rechte darf der Wecker nich rappeln. Mach an den Bums, sonst verpennste."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही सूचना बंद केल्यास, तुमचा अलार्म कदाचित नीट चालणार नाही. कृपया त्या चालू ठेवा."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvis du slår av varsler, kan det hende at alarmen din ikke fungerer som den skal. Vennligst la dem være på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je meldingen uitschakelt, werkt je wekker mogelijk niet goed. Laat ze a.u.b. ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli wyłączysz powiadomienia, Twój alarm może nie działać prawidłowo. Zostaw je włączone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você desativar as notificações, seu alarme pode não funcionar direito. Por favor, deixe-as ativadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы выключите уведомления, ваш будильник может работать неправильно. Пожалуйста, оставьте их включенными."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Om du stänger av aviseringar kanske ditt larm inte fungerar som det ska. Låt dem vara på."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn d'Meldonga ausmachsch, funktioniert dei Wegger vielleicht net richtig. Bitte lass se aa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimleri kapatırsan alarmın düzgün çalışmayabilir. Lütfen açık bırak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви вимкнете сповіщення, ваш будильник може працювати неправильно. Будь ласка, залиште їх увімкненими."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn tắt thông báo, báo thức có thể không hoạt động đúng. Vui lòng bật chúng."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您关闭通知，闹钟可能无法正常工作。请保持开启状态。"
          }
        }
      }
    },
