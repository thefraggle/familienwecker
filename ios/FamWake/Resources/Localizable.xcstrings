    "login_google_error_no_account": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো Google অ্যাকাউন্ট পাওয়া যায়নি। ফোনের সেটিংসে লগ ইন করুন বা ইমেইল ব্যবহার করুন।"
