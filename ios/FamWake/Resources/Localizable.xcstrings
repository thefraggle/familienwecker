        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonun sizin için çalabilmesi adına lütfen ayarlardan kendi profilinizi seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, виберіть свій профіль у налаштуваннях, щоб телефон дзвонив саме для вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng chọn xem bạn là ai trong cài đặt để điện thoại có thể báo thức cho bạn."
