    "feedback_success_message": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাহায্য করার জন্য ধন্যবাদ! আপনার মতামত আমাদের অ্যাপটিকে সবার জন্য উন্নত করতে সাহায্য করে।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak for din hjælp! Din feedback hjælper os med at forbedre FamWake for alle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke für deine Hilfe! Dein Feedback hilft uns, FamWake für alle zu verbessern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thank you for your help! Your feedback helps us improve FamWake for everyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Gracias por tu ayuda! Tus comentarios nos ayudan a mejorar FamWake para todo el mundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci pour ton aide ! Tes retours nous aident à améliorer FamWake pour tout le monde."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke für diini Hilf! Diis Feedback hilft ois, FamWake für alli z'verbessere."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी मदद के लिए धन्यवाद! आपके सुझावों से हमें FamWake को सभी के लिए बेहतर बनाने में मदद मिलती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terima kasih atas bantuan Anda! Masukan Anda membantu kami membuat FamWake lebih baik untuk semua orang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grazie per il tuo aiuto! Il tuo feedback ci aiuta a migliorare FamWake per tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご協力ありがとうございます！皆様のフィードバックがFamWakeをさらに良くします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도와주셔서 감사합니다! 보내주신 의견은 FamWake를 모두에게 더 좋은 앱으로 만드는 데 큰 힘이 됩니다."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Danke dir! Hilft uns, die App für alle noch nen Ticken geiler zu machen."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमच्या मदतीबद्दल धन्यवाद! तुमचा अभिप्राय आम्हाला सर्वांसाठी FamWake सुधारण्यात मदत करतो."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Takk for hjelpen! Din tilbakemelding hjelper oss å forbedre FamWake for alle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedankt voor je hulp! Je feedback helpt ons om FamWake voor iedereen beter te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziękujemy za pomoc! Twoja opinia pomaga nam ulepszać FamWake dla każdego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigado pela sua ajuda! Seu feedback ajuda a melhorar o FamWake para todos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спасибо за вашу помощь! Ваш отзыв помогает нам улучшать FamWake для всех."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tack för din hjälp! Din feedback hjälper oss att förbättra FamWake för alla."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Dangge für d'Hilf! Dei Feedback hilft ons, FamWake für älle besser zom macha."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yardımınız için teşekkürler! Geri bildiriminiz FamWake'i herkes için geliştirmemize yardımcı oluyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дякуємо за вашу допомогу! Ваш відгук допомагає нам покращувати FamWake для всіх."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảm ơn bạn đã giúp đỡ! Phản hồi của bạn giúp chúng tôi cải thiện FamWake cho tất cả mọi người."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "感谢您的帮助！您的反馈能帮助我们为所有人改进 FamWake。"
          }
        }
      }
    },
