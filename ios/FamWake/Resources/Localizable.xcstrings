    "feedback_intro": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপটিকে আরও ভালো করতে সাহায্য করুন! আপনার মনে কী আছে?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjælp os med at gøre appen endnu bedre! Hvad har du på hjerte?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf uns, die App noch besser zu machen! Was hast du auf dem Herzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Help us make the app even better! What's on your mind?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Ayúdanos a mejorar la app! ¿Qué nos quieres contar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide-nous à rendre l'appli encore meilleure ! Qu'as-tu en tête ?"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf ois, d'App na besser z'mache! Was häsch uf em Härze?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप को और भी बेहतर बनाने में हमारी मदद करें! आप क्या कहना चाहते हैं?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bantu kami membuat aplikasi ini lebih baik! Apa yang ingin Anda sampaikan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aiutaci a migliorare l'app! A cosa stai pensando?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリをより良くするためにご協力ください！お気づきの点はありませんか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 더 좋게 만들 수 있도록 도와주세요! 어떤 점이 궁금하신가요?"
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf uns, die Bude besser zu machen! Wat drückt?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "ॲप आणखी चांगले बनवण्यात आम्हाला मदत करा! तुमच्या मनात काय आहे?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjelp oss å gjøre appen enda bedre! Hva har du på hjertet?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Help ons de app nog beter te maken! Wat heb je op je hart?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomóż nam ulepszyć aplikację! Co masz na myśli?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajude a gente a melhorar o app! O que você tem em mente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помогите нам сделать приложение еще лучше! Что у вас на уме?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hjälp oss göra appen ännu bättre! Vad tänker du på?"
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Hilf ons, die App no besser zom macha! Was druckt di?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamayı daha da iyi yapmamıza yardım edin! Aklınızda ne var?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Допоможіть нам зробити додаток ще кращим! Що у вас на думці?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy giúp chúng tôi làm cho ứng dụng tốt hơn nữa! Bạn đang nghĩ gì?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "帮助我们改进应用！您有什么想法？"
          }
        }
      }
    },
