    "onboarding_slide3_body": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমন্ত্রণ কোড শেয়ার করুন আর আপনার পরিবার যুক্ত হয়ে যাবে। কেউ সময় বদলালে সবার রুটিন নিজে থেকেই আপডেট হয়ে যাবে।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del din invitationskode, og din familie er med. Hvis nogen ændrer deres tider, opdateres alles tidsplan med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile deinen Code und deine Familie ist dabei. Ändert jemand seine Zeiten, passt sich der Plan für alle sofort an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your invite code and your family is in. If someone changes their times, everyone's schedule updates instantly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu código de invitación y tu familia estará dentro. Si alguien cambia sus horas, el horario de todos se actualiza al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage ton code et ta famille est intégrée. Si quelqu'un modifie ses horaires, le planning de tout le monde se met à jour instantanément."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Teil diin Code und diini Familie isch debii. Ändert öpper sini Ziite, passt sich de Plan für alli sofort aa."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना इनवाइट कोड शेयर करें और आपका परिवार जुड़ जाएगा। अगर कोई अपना समय बदलता है, तो सभी का रूटीन अपने आप अपडेट हो जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan kode undangan Anda dan keluarga langsung bergabung. Jika ada yang mengubah waktunya, jadwal semua orang otomatis diperbarui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi il tuo codice di invito e la tua famiglia è dentro. Se qualcuno cambia i suoi orari, il programma di tutti si aggiorna all'istante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードを共有すれば、家族がすぐに参加できます。誰かが時間を変更しても、全員のスケジュールがすぐに更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드를 공유하면 가족들이 쉽게 참여할 수 있습니다. 누군가 시간을 변경하면 모두의 일정이 즉시 업데이트됩니다."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Teil nen Code und deine Truppe is dabei. Wenn einer wat ändert, is der Plan für alle direkt neu."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुमचा आमंत्रण कोड शेअर करा आणि तुमचे कुटुंब जोडले जाईल. जर कोणी त्यांची वेळ बदलली, तर सर्वांचे वेळापत्रक आपोआप अपडेट होते."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del invitasjonskoden din, så er familien med. Når noen endrer tidene sine, oppdateres alles tidsplan umiddelbart."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel je uitnodigingscode en je familie doet direct mee. Als iemand zijn tijden aanpast, wordt het schema van iedereen meteen bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij kod, a Twoja rodzina dołączy. Jeśli ktoś zmieni swój czas, plan zaktualizuje się automatycznie dla wszystkich."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe seu código de convite e sua família entra na hora. Se alguém mudar de horário, o cronograma de todos é atualizado na hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь кодом приглашения, и ваша семья сразу присоединится. Если кто-то изменит свое время, расписание обновится у всех моментально."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela din inbjudningskod så är din familj med. Om någon ändrar sina tider uppdateras allas schema direkt."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Teil dein Code ond dei Familie isch sofort debei. Wenn ebber was ändert, isch dr Plan für älle sofort nei berechnet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet kodunuzu paylaşın ve aileniz hemen katılsın. Biri saatlerini değiştirirse, herkesin planı anında güncellenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поділіться кодом запрошення, і ваша родина миттєво приєднається. Якщо хтось змінить свій час, розклад оновиться для всіх автоматично."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia sẻ mã mời và gia đình bạn sẽ tham gia ngay. Nếu ai đó thay đổi thời gian, lịch trình của mọi người sẽ cập nhật tức thì."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "分享邀请码，您的家人即可立即加入。如果有人更改了时间，所有人的日程表都会立即更新。"
          }
        }
      }
    },
