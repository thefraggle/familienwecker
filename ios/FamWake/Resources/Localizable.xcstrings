    "tooltip_wake_window": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমাদের একটি সময় দিন। অ্যাপটি এর মধ্যে সঠিক সময়টি বেছে নেবে যাতে কাউকে বাথরুমের জন্য অপেক্ষা করতে না হয়।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Giv os et tidsvindue. Appen finder det perfekte øjeblik at vække dig, så du ikke behøver at vente på badeværelset."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib uns ein Zeitfenster. Die App findet den perfekten Moment zum Wecken, damit du nicht vor dem Bad warten musst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give us a time window. The app will find the perfect moment to wake you up so you don't have to wait for the bathroom."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Danos un margen de tiempo. La app encontrará el momento perfecto para despertarte y que no tengas que esperar para ir al baño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne-nous une plage horaire. L'appli trouvera le moment parfait pour te réveiller afin que tu n'aies pas à attendre pour la salle de bain."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gih ois es Ziitfänster. D'App findt de perfäkti Momänt zum Wecke, demit du nöd vorem Bad warte muesch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें एक टाइम विंडो (समय-सीमा) दें। ऐप आपको जगाने के लिए सबसे सही समय ढूँढ लेगा ताकि आपको बाथरूम के लिए इंतज़ार न करना पड़े।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri kami rentang waktu. Aplikasi ini akan menemukan momen yang tepat untuk membangunkan Anda sehingga Anda tidak perlu mengantre kamar mandi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dacci una finestra di tempo. L'app troverà il momento perfetto per svegliarti senza farti aspettare per il bagno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きる時間の枠を教えてください。バスルームを待たなくていい完璧なタイミングをアプリが見つけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일어날 수 있는 시간 범위를 알려주세요. 아무도 화장실을 기다리지 않도록 앱이 가장 좋은 타이밍을 찾아냅니다."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib uns nen Zeitraum. Die App macht dat schon passend, dat keiner meckert."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "आम्हाला एक वेळेची मर्यादा द्या. ॲप तुम्हाला उठवण्यासाठी योग्य वेळ शोधेल जेणेकरून तुम्हाला बाथरूमसाठी वाट पाहावी लागणार नाही."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi oss et tidsvindu. Appen vil finne det perfekte tidspunktet for å vekke deg, slik at du ikke trenger å vente på badet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef ons een tijdsvenster. De app vindt het perfecte moment daarbinnen om je wakker te maken, zodat je niet op de badkamer hoeft te wachten."
          }
        },
        "pl": {
