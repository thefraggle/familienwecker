    "join_conflict_text": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি ইতিমধ্যেই \"%@\" এর সদস্য। নতুন পরিবারে যুক্ত হতে চাইলে, আগে এটি ছাড়তে হবে। আপনি কি \"%@\" ছেড়ে নতুনটিতে যুক্ত হতে চান?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er allerede med i \"%@\". For at deltage i den nye familie skal du først forlade denne. Vil du forlade \"%@\" og deltage i den nye?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist bereits in \"%@\". Um der neuen Familie beizutreten, musst du diese zuerst verlassen. Möchtest du \"%@\" verlassen und der neuen beitreten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are already in \"%@\". To join the new family, you need to leave this one first. Do you want to leave \"%@\" and join the new one?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya estás en \"%@\". Para unirte a la nueva, primero tienes que salir de esta. ¿Quieres salir de \"%@\" y unirte a la nueva?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es déjà dans la famille \"%@\". Pour rejoindre la nouvelle, tu dois d'abord quitter celle-ci. Veux-tu quitter \"%@\" et rejoindre la nouvelle ?"
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bisch scho in \"%@\". Zum de neue Familie biiträte, muesch die z'erst verlaa. Wottsch \"%@\" verlaa und de neue biiträte?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पहले से ही \"%@\" में हैं। नए परिवार में शामिल होने के लिए, आपको पहले इसे छोड़ना होगा। क्या आप \"%@\" को छोड़कर नए परिवार से जुड़ना चाहते हैं?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah berada di \"%@\". Untuk bergabung dengan keluarga baru, Anda harus keluar dari keluarga ini terlebih dahulu. Apakah Anda ingin keluar dari \"%@\" dan bergabung dengan yang baru?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei già nella famiglia \"%@\". Per unirti a quella nuova, devi prima lasciare questa. Vuoi lasciare \"%@\" e unirti alla nuova?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはすでに「%@」に参加しています。新しい家族に参加するには、今の家族を抜ける必要があります。「%@」を抜けて新しい家族に参加しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 \"%@\" 가족에 참여 중입니다. 새 가족에 참여하려면 먼저 현재 가족에서 나가야 합니다. \"%@\"에서 나가고 새로운 가족에 참여하시겠습니까?"
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "Bisse schon inne Familie \"%@\". Muss erst da raus. Willste \"%@\" verlassen und inne neue?"
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "तुम्ही आधीच \"%@\" मध्ये आहात. नवीन कुटुंबात सामील होण्यासाठी, तुम्हाला आधी हे सोडावे लागेल. तुम्हाला \"%@\" सोडून नवीन कुटुंबात सामील व्हायचे आहे का?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er allerede med i \"%@\". For å bli med i den nye familien, må du forlate denne først. Vil du forlate \"%@\" og bli med i den nye?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent al lid van de familie \"%@\". Om lid te worden van de nieuwe familie, moet je eerst deze verlaten. Wil je \"%@\" verlaten en deelnemen aan de nieuwe?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś już członkiem rodziny „%@”. Aby dołączyć do nowej, musisz najpierw opuścić tę. Czy chcesz opuścić „%@” i dołączyć do nowej?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já está em \"%@\". Para entrar na nova família, você precisa sair desta primeiro. Deseja sair de \"%@\" e entrar na nova?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уже являетесь участником семьи \"%@\". Чтобы присоединиться к новой, вам нужно сначала покинуть текущую. Вы хотите покинуть \"%@\" и присоединиться к новой?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är redan med i \"%@\". För att gå med i den nya familjen måste du lämna den här först. Vill du lämna \"%@\" och gå med i den nya?"
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bisch scho in \"%@\". Wenn d'inne neie woisch, musch do zerscht raus. Woisch \"%@\" verlassa ond zur neia nei?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten \"%@\" ailesindesiniz. Yeni aileye katılmak için önce buradan ayrılmalısınız. \"%@\" ailesinden ayrılıp yeni aileye katılmak istiyor musunuz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви вже є учасником сім'ї \"%@\". Щоб приєднатися до нової, вам потрібно спочатку покинути поточну. Ви хочете покинути \"%@\" і приєднатися до нової?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã là thành viên của gia đình \"%@\". Để tham gia gia đình mới, bạn cần rời khỏi gia đình hiện tại trước. Bạn có muốn rời \"%@\" và tham gia gia đình mới không?"
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "您已经是“%@”的成员。要加入新家庭，您必须先退出当前家庭。您想退出“%@”并加入新家庭吗？"
          }
        }
      }
    },
