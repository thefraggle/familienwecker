    "main_exact_alarm_banner": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ অ্যালার্ম ব্লক করা আছে! আপনি যেন সময়মতো উঠতে পারেন, তাই সেটিংসে অ্যালার্মের অনুমতি দিন।"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Alarm blokeret! Tillad alarmer i dine indstillinger, så du vågner til tiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Wecker blockiert! Bitte erlaube Wecker in den Einstellungen, damit du pünktlich aufwachst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Alarm blocked! Please allow alarms in your settings so you wake up on time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ ¡Alarma bloqueada! Por favor, permite las alarmas en tus ajustes para que te despiertes a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Réveil bloqué ! Autorise les réveils dans tes paramètres pour être réveillé(e) à temps."
          }
        },
        "gsw": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Wecker blockiert! Bitte erlaub Wecker i de Iistellige, demit du pünktlich uufwachsch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ अलार्म ब्लॉक है! कृपया सेटिंग्स में अलार्म को अनुमति दें ताकि आप समय पर उठ सकें。"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Alarm diblokir! Tolong izinkan alarm di pengaturan agar Anda bisa bangun tepat waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Sveglia bloccata! Consenti le sveglie nelle impostazioni per poterti svegliare in orario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ アラームがブロックされています！時間通りに起きられるように設定でアラームを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 알람이 차단되었습니다! 제시간에 일어날 수 있도록 설정에서 알람을 허용해 주세요."
          }
        },
        "ksh": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Wecker darf nich bimmeln! Gib uns dat grüne Licht inne Einstellungen."
          }
        },
        "mr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ अलार्म ब्लॉक केला! तुमचा अलार्म वेळेवर वाजू शकेल यासाठी कृपया सेटिंग्जमध्ये अलार्मला परवानगी द्या."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Alarm blokkert! Tillat alarmer i innstillingene dine slik at du våkner i tide."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Wekker geblokkeerd! Geef toestemming in je instellingen zodat je wekker op tijd afgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Alarm zablokowany! Zezwól na alarmy w ustawieniach, aby obudzić się na czas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Alarme bloqueado! Por favor, permita alarmes nas configurações para que o alarme toque na hora certa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Будильник заблокирован! Пожалуйста, разрешите будильники в настройках, чтобы просыпаться вовремя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Larm blockerat! Tillåt larm i dina inställningar så att du vaknar i tid."
          }
        },
        "swg": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Wegger blockiert! Bitte geb d'Recht in de Eistellonga fürn Wegger frei, damit d'pünktlich wachs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Alarm engellendi! Zamanında uyanabilmek için lütfen ayarlardan alarm izni verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Будильник заблоковано! Будь ласка, дозвольте будильники в налаштуваннях, щоб прокидатися вчасно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ Báo thức bị chặn! Vui lòng cấp quyền báo thức trong cài đặt để báo thức có thể reo đúng giờ."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ 闹钟被阻止！请在设置中允许闹钟权限，以便您能准时起床。"
          }
        }
      }
    },
    "main_fallback_alarm_active": {
      "extractionState": "stale",
      "localizations": {
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠️ সতর্কবার্তা: এখনকার রুটিনটি ঠিক মিলছে না (%@)। সময়গুলো একটু ঠিক করুন!"
