    "notif_channel_evening_reminder_desc": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnert dich abends daran, deinen Weckplan zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds you in the evening to check your alarm schedule."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Minder dig om aftenen om at tjekke din vækkeplan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te recuerda por la noche que revises tu horario de despertador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Te rappelle le soir de vérifier ton planning de réveil."
