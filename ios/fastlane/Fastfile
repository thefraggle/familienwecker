default_platform(:ios)

platform :ios do
  desc "Upload a new build to TestFlight"
  lane :release do |options|
    # 1. Authenticate with App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false
    )

    # 2. Get latest build number from TestFlight and increment
    version_name = options[:version_name]
    if version_name.to_s.empty?
      UI.user_error!("Please provide a version_name (e.g. fastlane release version_name:1.2.3)")
    end

    begin
      latest_build = latest_testflight_build_number(
        api_key: api_key,
        version: version_name,
        app_identifier: "de.familienwecker.FamWake"
      )
      new_build_number = latest_build + 1
    rescue => e
      UI.message("Could not fetch latest TestFlight build number (likely because this version has no builds yet): #{e.message}")
      new_build_number = 1
    end

    UI.message("Setting build number to #{new_build_number} for version #{version_name}")

    # Update version and build number in Xcode project
    increment_version_number(
      version_number: version_name,
      xcodeproj: "FamWake.xcodeproj"
    )
    increment_build_number(
      build_number: new_build_number,
      xcodeproj: "FamWake.xcodeproj"
    )

    # 3. Build the app using manual signing
    build_app(
      scheme: "FamWake",
      project: "FamWake.xcodeproj",
      export_method: "app-store",
      output_directory: "build",
      output_name: "FamWake.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "de.familienwecker.FamWake" => "FamWake AppStore"
        }
      }
    )

    # 4. Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/FamWake.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
