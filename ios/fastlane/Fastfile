default_platform(:ios)

platform :ios do
  desc "Upload a new build to TestFlight"
  lane :release do |options|
    # 1. Authenticate with App Store Connect API Key
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false
    )

    # 2. Get latest build number from TestFlight and increment
    version_name = options[:version_name]
    if version_name.to_s.empty?
      UI.user_error!("Please provide a version_name (e.g. fastlane release version_name:1.2.3)")
    end

    begin
      latest_build = latest_testflight_build_number(
        api_key: api_key,
        version: version_name,
        app_identifier: "de.familienwecker.FamWake"
      )
      new_build_number = latest_build + 1
    rescue => e
      UI.message("Could not fetch latest TestFlight build number (likely because this version has no builds yet): #{e.message}")
      new_build_number = 1
    end

    UI.message("Setting build number to #{new_build_number} for version #{version_name}")

    # Update version and build number in Xcode project
    increment_version_number(
      version_number: version_name,
      xcodeproj: "FamWake.xcodeproj"
    )
    increment_build_number(
      build_number: new_build_number,
      xcodeproj: "FamWake.xcodeproj"
    )

    # 3. Build the app using manual signing
    build_app(
      scheme: "FamWake",
      project: "FamWake.xcodeproj",
      export_method: "app-store",
      output_directory: "build",
      output_name: "FamWake.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: {
          "de.familienwecker.FamWake" => "FamWake AppStore"
        }
      }
    )

    # 4. Read EN changelog for TestFlight "What's New"
    changelog_file = File.join(Dir.pwd, "..", "docs", "CHANGELOG.en.md")
    changelog_text = ""
    if File.exist?(changelog_file)
      content = File.read(changelog_file)
      # Extract the first version block (everything between first ## and next ##)
      match = content.match(/## [\d.]+.*?\n(.*?)(?=\n## \d|\z)/m)
      if match
        raw = match[1].strip
        # Clean up Markdown: strip bold/italic, bullet prefixes, section headers
        lines = raw.split("\n").map { |l| l.strip }.reject { |l| l.empty? || l.start_with?("###") }
        lines = lines.map { |l| l.gsub(/(\*\*|\*|__|_)/, '').sub(/^- /, '').strip }.reject(&:empty?)
        changelog_text = lines.join(". ")
      end
    end
    UI.message("TestFlight changelog: #{changelog_text[0..100]}...") unless changelog_text.empty?

    # 5. Upload to TestFlight with changelog
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/FamWake.ipa",
      changelog: changelog_text.empty? ? nil : changelog_text,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end

  desc "Upload multi-language release notes to App Store Connect (no binary, no submit)"
  lane :upload_metadata do
    # Authenticate
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false
    )

    # Upload only release notes metadata — no binary, no screenshots, no submit
    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      force: true,
      submit_for_review: false,
      automatic_release: false,
      metadata_path: "./fastlane/metadata",
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      skip_app_version_update: false
    )
  end

  desc "Upload only screenshots to App Store Connect"
  lane :upload_screenshots do
    # Authenticate
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
      is_key_content_base64: false
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: false,
      skip_metadata: true,
      force: true,
      submit_for_review: false,
      screenshots_path: "./fastlane/screenshots"
    )
  end

  desc "Generiert alle App Store Screenshots in allen Sprachen"
  lane :generate_screenshots do
    capture_screenshots
    sh("python3 ../../scripts/generate_html.py")
  end
end
